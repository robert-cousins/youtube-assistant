+
+
+//  yth daemon settings 
+// The daemon is what makes the other Chrome profile and phone likes visible
+// here. Token comes from `yth serve` (also at ~/.config/yth/daemon-token).
+(() => {
+  const url = document.getElementById('yth-url');
+  const token = document.getElementById('yth-token');
+  const status = document.getElementById('yth-status');
+  if (!url || !token) return;
+
+  chrome.storage.local.get({ ythUrl: 'http://127.0.0.1:8742', ythToken: '' }, (cfg) => {
+    url.value = cfg.ythUrl;
+    token.value = cfg.ythToken;
+  });
+
+  const save = () => chrome.storage.local.set({
+    ythUrl: url.value.trim() || 'http://127.0.0.1:8742',
+    ythToken: token.value.trim()
+  });
+  url.onchange = save;
+  token.onchange = save;
+
+  const testBtn = document.getElementById('yth-test');
+  if (testBtn) testBtn.onclick = () => {
+    save();
+    status.textContent = 'Checking...';
+    fetch(url.value.trim() + '/recent?since=0', { headers: { 'X-YTH-Token': token.value.trim() } })
+      .then((r) => r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)))
+      .then((d) => { status.textContent = `Connected — ${d.count} record(s) waiting.`; })
+      .catch((e) => { status.textContent = `Not reachable: ${e.message}. Is \`yth serve\` running?`; });
+  };
+})();
