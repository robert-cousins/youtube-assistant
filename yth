# gemini-2.5-flash-lite holds ~1M tokens, so even a multi-hour transcript fits in
# one call. This cap exists only to bound cost and latency on pathological input.
MAX_TRANSCRIPT_CHARS = 600_000


class CannotVerify(Exception):
    """Verification could not run -- distinct from having found nothing wrong."""


class NoTranscript(Exception):
    """The video has no usable transcript — a permanent condition, not a failure."""


def load_glossary(conn, channel):
    if not channel:
        return []
    return [(r["wrong"], r["right"]) for r in conn.execute(
        "SELECT wrong, right FROM channel_terms WHERE channel = ?"
        " ORDER BY LENGTH(wrong) DESC", (channel,))]


def apply_glossary(text, terms):
    """Literal, whole-word, case-insensitive repair of known caption errors.

    Returns (repaired_text, {term: count}). Longest terms are applied first so a
    multi-word entry is not broken up by a single-word one.
    """
    applied = {}
    for wrong, right in terms:
        pattern = re.compile(r"\b" + re.escape(wrong) + r"\b", re.IGNORECASE)
        text, n = pattern.subn(right, text)
        if n:
            applied[f"{wrong}->{right}"] = n
    return text, applied


def fetch_transcript(video_id):
    if not TRANSCRIPT_SCRIPT.exists():
        raise RuntimeError(f"transcript script missing at {TRANSCRIPT_SCRIPT}")
    if not TRANSCRIPT_PYTHON.exists():
        raise RuntimeError(
            f"transcript venv missing at {TRANSCRIPT_PYTHON} — create it with:\n"
            f"  uv venv ~/.local/share/yth-venv && "
            f"uv pip install --python {TRANSCRIPT_PYTHON} youtube-transcript-api")

    proc = subprocess.run(
        [str(TRANSCRIPT_PYTHON), str(TRANSCRIPT_SCRIPT), video_id, "--text-only", "--clean"],
        capture_output=True, text=True, timeout=120)
    out = (proc.stdout or "").strip()
    err = (proc.stderr or "").strip()

    # The helper signals failure with exit 1 AND a JSON {"error": ...} on
    # stdout. Checking neither is dangerous: the error text looks like ordinary
    # prose, so it sails into the model, which obligingly summarises the error
    # message and stores it as though it were the video.
    if proc.returncode != 0 or not out:
        message = out or err or "no transcript returned"
        try:
            parsed = json.loads(out)
            if isinstance(parsed, dict) and parsed.get("error"):
                message = str(parsed["error"])
        except (ValueError, TypeError):
            pass
        message = " ".join(message.split())
        # A network blip should stay retryable; an unavailable or
        # transcript-less video should not be retried on every click.
        transient = any(w in message.lower() for w in
                        ("timed out", "timeout", "connection", "temporarily",
                         "too many requests", "network", "resolve"))
        if transient:
            raise RuntimeError(message)
        raise NoTranscript(message)

    # Belt and braces: a zero exit with a JSON error body would otherwise pass.
    if out.startswith("{") and '"error"' in out[:120]:
        try:
            parsed = json.loads(out)
            raise NoTranscript(" ".join(str(parsed.get("error", out)).split()))
        except ValueError:
            pass
    return out[:MAX_TRANSCRIPT_CHARS]


def summarise_text(transcript, prompt=SUMMARY_PROMPT, max_tokens=700, model=None):
    key = os.environ.get("OPENROUTER_API_KEY")
    if not key:
        raise RuntimeError("OPENROUTER_API_KEY is not set in the daemon's environment")

    body = json.dumps({
        "model": model or SUMMARY_MODEL,
        "messages": [{"role": "user",
                      "content": f"{prompt}\n\n---TRANSCRIPT---\n{transcript}"}],
        "max_tokens": max_tokens,
        # Ask OpenRouter for the real billed cost rather than deriving it from a
        # price table that can drift.
        "usage": {"include": True},
    }).encode()
    req = urllib.request.Request(
        OPENROUTER_URL, data=body,
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=180) as r:
        data = json.loads(r.read())
    choices = data.get("choices") or []
    if not choices:
        raise RuntimeError(f"no completion returned: {json.dumps(data)[:200]}")
    return choices[0]["message"]["content"].strip(), data.get("usage") or {}


def format_cost(cost):
    """Costs here run to fractions of a cent, so two decimals would read $0.00."""
    if not cost:
        return "$0"
    if cost >= 0.01:
        return f"${cost:.2f}"
    return f"${cost:.5f}".rstrip("0").rstrip(".")


def summary_footer(cost, ms):
    if ms is None:
        return ""
    return f"Summary cost {format_cost(cost)}, took {ms / 1000:.1f} sec"


def summarise_video(conn, video_id, prompt=SUMMARY_PROMPT):
    """Fetch, summarise and store. Returns (state, text)."""
    started = time.monotonic()
    now = int(datetime.now(timezone.utc).timestamp() * 1000)
    try:
        transcript = fetch_transcript(video_id)
    except NoTranscript as exc:
        conn.execute(
            "UPDATE videos SET summary = NULL, summary_state = 'no_transcript',"
            " summary_at = ?, row_updated = ? WHERE video_id = ?",
            (now, now, video_id))
        conn.commit()
        return "no_transcript", str(exc)
    except Exception as exc:
        conn.execute(
            "UPDATE videos SET summary_state = 'error', summary_at = ?,"
            " row_updated = ? WHERE video_id = ?", (now, now, video_id))
        conn.commit()
        return "error", str(exc)

    row = conn.execute("SELECT channel FROM videos WHERE video_id = ?",
                       (video_id,)).fetchone()
    transcript, _ = apply_glossary(transcript, load_glossary(conn, row["channel"] if row else ""))

    try:
        text, usage = summarise_text(transcript, prompt)
    except Exception as exc:
        conn.execute(
            "UPDATE videos SET summary_state = 'error', summary_at = ?,"
            " row_updated = ? WHERE video_id = ?", (now, now, video_id))
        conn.commit()
        return "error", str(exc)

    # Wall clock for the whole path -- transcript fetch included -- because that
    # is what the click actually costs in waiting.
    elapsed_ms = int((time.monotonic() - started) * 1000)
    conn.execute(
        "UPDATE videos SET summary = ?, summary_state = 'ok', summary_at = ?,"
        " summary_cost = ?, summary_ms = ?, summary_tokens_in = ?,"
        " summary_tokens_out = ?, row_updated = ? WHERE video_id = ?",
        (text, now, usage.get("cost"), elapsed_ms, usage.get("prompt_tokens"),
         usage.get("completion_tokens"), now, video_id))
    conn.commit()
    return "ok", text


def generate_article(conn, video_id):
    """Long-form article for the email. Separate prompt, separate column.

    The model is given the title, channel and publication date explicitly: the
    prompt asks for a byline with the creator and date, and none of that appears
    in a transcript.
    """
    row = conn.execute("SELECT * FROM videos WHERE video_id = ?", (video_id,)).fetchone()
    if row is None:
        return "error", f"{video_id} is not in the record"

    started = time.monotonic()
    try:
        transcript = fetch_transcript(video_id)
    except NoTranscript as exc:
        now = int(datetime.now(timezone.utc).timestamp() * 1000)
        conn.execute("UPDATE videos SET summary_state = 'no_transcript', summary_at = ?,"
                     " row_updated = ? WHERE video_id = ?", (now, now, video_id))
        conn.commit()
        return "no_transcript", str(exc)
    except Exception as exc:
        return "error", str(exc)

    terms = load_glossary(conn, row["channel"])
    transcript, repaired = apply_glossary(transcript, terms)
    if repaired:
        print(f"  glossary [{row['channel']}]: "
              + ", ".join(f"{k} x{v}" for k, v in repaired.items()))

    conn.execute("UPDATE videos SET transcript = ? WHERE video_id = ?",
                 (transcript, video_id))
    conn.commit()

    published = (row["published_at"] or "")[:10]
    context = (
        "METADATA (use for the byline; do not infer anything else from it):\n"
        f"Video title: {row['title']}\n"
        f"Channel / creator: {row['channel'] or 'unknown'}\n"
        + (f"Published date: {published}\n" if published
           else "Published date: UNKNOWN - omit the date from the byline entirely.\n")
        + (f"Video description (creator's own words):\n{(row['description'] or '')[:1500]}\n"
           if row["description"] else "")
        + "\nHOW TO USE THIS METADATA: the title and description are written by the "
          "creator, so their spellings of names and organisations are authoritative "
          "where the auto-generated transcript's are not. If the transcript garbles a "
          "proper noun that appears correctly spelled here, use this spelling. Do NOT "
          "import claims, figures or people that appear only here and never in the "
          "transcript - the title is often promotional. Metadata settles SPELLING, the "
          "transcript settles SUBSTANCE.\n")
    try:
        text, usage = summarise_text(
            f"{context}\n{transcript}", prompt=ARTICLE_PROMPT, max_tokens=4000,
            model=load_config().get("article_model", SUMMARY_MODEL))
    except Exception as exc:
        return "error", str(exc)

    now = int(datetime.now(timezone.utc).timestamp() * 1000)
    conn.execute(
        "UPDATE videos SET article = ?, article_at = ?, article_cost = ?,"
        " article_ms = ?, row_updated = ? WHERE video_id = ?",
        (text, now, usage.get("cost"), int((time.monotonic() - started) * 1000),
         now, video_id))
    conn.commit()
    return "ok", text


# Words that start sentences or headings constantly; flagging them as entities
# would bury the real findings in noise.
VERIFY_STOPWORDS = {
    "the","this","that","these","those","and","but","for","from","with","while",
    "when","where","what","which","who","however","although","despite","beyond",
    "because","since","after","before","during","through","throughout","across",
    "under","over","into","onto","between","among","against","without","within",
    "further","furthermore","moreover","meanwhile","instead","rather","perhaps",
    "such","some","many","most","much","more","less","other","another","each",
    "every","both","either","neither","one","two","three","first","second","third",
    "his","her","its","their","our","your","they","them","there","here","then",
    "now","today","yesterday","tomorrow","published","summary","article","note",
    "conclusion","introduction","background","context","analysis","implications",
    "key","main","overall","finally","ultimately","indeed","yet","still","also",
    "unthinkable","operation","strategic","global","economic","financial","reports",
    "according","dangerous","mounting","targeting","cutting","excluding","rise",
    "specter","dire","factor","pressures","warfare","disruption","lifelines","dump",
}


def verify_article(conn, video_id, article=None, transcript=None):
    """Flag entities in the article that nothing in the source vouches for.

    The haystack is the repaired transcript plus the creator's own title and
    description. Anything named in the article but absent from all of them was
    supplied by the model, which is precisely the failure this exists to catch.
    """
    row = conn.execute("SELECT * FROM videos WHERE video_id = ?", (video_id,)).fetchone()
    if row is None:
        return ["video not in record"]
    article = article if article is not None else (row["article"] or "")
    if not article:
        return []

    if transcript is None:
        transcript = row["transcript"] or ""
    if not transcript:
        try:
            transcript, _ = apply_glossary(fetch_transcript(video_id),
                                           load_glossary(conn, row["channel"]))
        except Exception as exc:
            # Cannot verify is NOT the same as nothing to report. Falling back to
            # an empty source made every entity look invented, which is a false
            # accusation dressed as diligence.
            raise CannotVerify(str(exc)[:160])

    haystack = " ".join(filter(None, [
        transcript, row["title"] or "", row["description"] or "",
        row["channel"] or "",
        " ".join(r["right"] for r in conn.execute(
            "SELECT right FROM channel_terms WHERE channel = ?", (row["channel"],))),
    ])).lower()

    # Headings and line breaks are sentence boundaries. Without this, a candidate
    # runs across a newline ("Dangerous Escalation\n\nThe") and every heading
    # becomes a false positive.
    # Headings and the byline are the model's own framing, not factual claims --
    # their wording will never appear verbatim in a transcript, so including them
    # buries the real findings under invented-sounding section titles.
    lines = []
    for line in article.split("\n"):
        # Emphasis markers must go FIRST: leaving them in place breaks both the
        # byline test and the sentence-boundary detection, because "**Word" is
        # not adjacent to the preceding full stop.
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        # Order matters. Drop the list marker, then the bold lead-in label
        # ("**Lead Capture:**"), which is structural like a heading, and only
        # then remove remaining emphasis.
        stripped = re.sub(r"^[-*\u2022]\s+|^\d+[.)]\s+", "", stripped)
        stripped = re.sub(r"^\*\*[^*]{1,60}\*\*:?\s*", "", stripped)
        stripped = re.sub(r"\*+", "", stripped).strip()
        if not stripped:
            continue
        if re.match(r"^(by|published)\b", stripped, re.I):
            continue
        if re.match(r"^[A-Z][a-z]+\s+\d{1,2},?\s+\d{4}$", stripped):
            continue                       # a bare byline date
        lines.append(stripped)
    body = " . ".join(lines)
    candidates = set()
    # Acronyms: the highest-signal case, and cheap to check.
    candidates.update(re.findall(r"\b[A-Z]{2,6}\b", body))
    # Capitalised runs of 2-3 words: people, organisations, places.
    candidates.update(m.group(0).strip() for m in
                      re.finditer(r"\b[A-Z][a-z]{2,}(?:\s+[A-Z][a-z]{2,}){1,2}\b", body))
    # Lone capitalised words that do not open a sentence.
    for m in re.finditer(r"([.!?:;]\s+)?\b([A-Z][a-z]{3,})\b", body):
        if not m.group(1):
            candidates.add(m.group(2))

    unverified = []
    for cand in sorted(candidates):
        words = [w for w in re.split(r"\s+", cand) if w]
        if all(w.lower() in VERIFY_STOPWORDS for w in words):
            continue
        # A multi-word entity counts as grounded if every word of it appears.
        if all(w.lower() in haystack for w in words):
            continue
        unverified.append(cand)
    return unverified


def cmd_verify(conn, video_id):
    try:
        flagged = verify_article(conn, video_id)
    except CannotVerify as exc:
        print(f"CANNOT VERIFY - {exc}")
        return
    if not flagged:
        print("OK - every entity in the article is grounded in the source.")
    else:
        print(f"{len(flagged)} unverified entit(ies) - not found in transcript, "
              f"title or description:")
        for f in flagged:
            print(f"  {f}")


def cmd_article(conn, video_id):
    state, text = generate_article(conn, video_id)
    print(text if state == "ok" else f"[{state}] {text}")


def cmd_summarise(conn, video_id):
    state, text = summarise_video(conn, video_id)
    if state == "ok":
        print(text)
        row = conn.execute(
            "SELECT summary_cost, summary_ms, summary_tokens_in, summary_tokens_out"
            " FROM videos WHERE video_id = ?", (video_id,)).fetchone()
        print(f"\n{summary_footer(row['summary_cost'], row['summary_ms'])}"
              f"  ({row['summary_tokens_in']} in / {row['summary_tokens_out']} out)")
    else:
        print(f"[{state}] {text}")


