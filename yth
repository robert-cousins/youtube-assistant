def html_escape(text):
    return (str(text or "").replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


def article_email_html(video, article, footer):
    url = WATCH_URL.format(video["video_id"])
    # No thumbnail: the article stands on its own, and a 320px YouTube still at
    # the top of a serif article reads like a newsletter ad.
    return f"""<div style="font-family:Georgia,'Times New Roman',serif;max-width:660px;
     margin:0 auto;color:#1a1a1a;line-height:1.65;font-size:17px">
