    &nbsp;&middot;&nbsp; {html_escape(footer)}
  </div>
</div>"""


def send_summary_email(video, summary, footer, to=None):
    """Send through Gmail as the authorised account.

    Gmail imposes no recipient restriction the way a transactional provider on
    an unverified domain does -- the account simply sends its own mail.
    """
    cfg = load_config()
    recipient = to or cfg["email_to"]
    if not recipient:
        raise RuntimeError('No recipient. Set "email_to" in'
                           ' ~/.config/yth/config.json, or pass --to.')
    token = access_token(GMAIL_CREDS_PATH)

    message = EmailMessage()
    message["To"] = recipient
    headline = article_headline(summary, video["title"] or video["video_id"])
    message["Subject"] = f"{cfg['email_subject_prefix']}{headline}"
    # From is normally left for Gmail to fill from the credential. Reading the
    # account's own address would need a read scope, and this tool holds
    # gmail.send only -- it can send mail and cannot read any. Set
    # email_from_address in the config to control the display name.
    sender = cfg.get("email_from_address")
    name = cfg.get("email_from_name")
    if sender:
        message["From"] = f"{name} <{sender}>" if name else sender
    message.set_content(
        f"{video['title']}\n{video['channel']}\n"
        f"{WATCH_URL.format(video['video_id'])}\n\n{summary}\n\n{footer}")
    message.add_alternative(article_email_html(video, summary, footer), subtype="html")

    raw = base64.urlsafe_b64encode(message.as_bytes()).decode()
    req = urllib.request.Request(
        f"{GMAIL_API}/messages/send", data=json.dumps({"raw": raw}).encode(),
        headers={"Authorization": f"Bearer {token}",
                 "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return recipient, json.loads(r.read()).get("id")
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode()[:400]
        try:
            detail = json.loads(detail)["error"]["message"]
        except (ValueError, KeyError):
            pass
        raise RuntimeError(f"Gmail rejected the message: {detail}")


def send_plain_email(subject, body, to=None):
    """A short notice, not a summary. Same Gmail path, no HTML alternative."""
    cfg = load_config()
    recipient = to or cfg["email_to"]
    if not recipient:
        raise RuntimeError('Set "email_to" in ~/.config/yth/config.json')
    token = access_token(GMAIL_CREDS_PATH)
    message = EmailMessage()
    message["To"] = recipient
    message["Subject"] = subject
    sender = cfg.get("email_from_address")
    name = cfg.get("email_from_name")
    if sender:
        message["From"] = f"{name} <{sender}>" if name else sender
    message.set_content(body)
    raw = base64.urlsafe_b64encode(message.as_bytes()).decode()
    req = urllib.request.Request(
        f"{GMAIL_API}/messages/send", data=json.dumps({"raw": raw}).encode(),
        headers={"Authorization": f"Bearer {token}",
                 "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return recipient, json.loads(r.read()).get("id")


def notify_budget_reached(budget, pending):
    """Tell the user the unsubscribe queue has stalled on quota.

    Best-effort: a failed notification must never stop the worker, and the same
    numbers are on /subs for the UI banner regardless of whether mail got out.
    """
    try:
        send_plain_email(
            "\u26a0\ufe0f yth: daily YouTube quota budget reached",
            f"The unsubscribe queue has paused.\n\n"
            f"  Quota day    {budget['day']} (resets midnight US Pacific)\n"
            f"  Spent        {budget['used']} of {budget['budget']} budgeted units\n"
            f"  Still queued {pending} channel(s)\n\n"
            f"Nothing is lost -- the queue resumes automatically after the reset. "
            f"You can cancel any of it from the Subscriptions tab in the meantime.\n")
    except Exception as exc:
        print(f"[subs] budget notification failed: {exc}")


def email_video_summary(conn, video_id, to=None, force=False):
    """Ensure a summary exists, then email it. Returns (state, detail)."""
    row = conn.execute("SELECT * FROM videos WHERE video_id = ?", (video_id,)).fetchone()
    if row is None:
        return "error", f"{video_id} is not in the record"

    # One send per video unless explicitly forced: the button greys out on the
    # strength of this, so the daemon has to enforce it rather than trusting the
    # UI -- two profiles could otherwise each send their own copy.
    if row["emailed_at"] and not force:
        when = perth_day(row["emailed_at"]).strftime("%d %b %H:%M")
        return "already_sent", f"{row['emailed_to'] or 'recipient'} on {when}"

    # George sends the long-form article, which is a different prompt and a
    # different column from the on-screen summary Robert produces.
    if not row["article"]:
        state, text = generate_article(conn, video_id)
        if state != "ok":
            return state, text
        row = conn.execute("SELECT * FROM videos WHERE video_id = ?", (video_id,)).fetchone()

    # Verification gate: nothing goes out with entities the source cannot vouch
    # for. This is the whole point of the exercise -- an article that looks
    # right but names things the speaker never said is worse than no article.
    if not force:
        try:
            flagged = verify_article(conn, video_id)
        except CannotVerify as exc:
            return "unverified", (f"could not check the article against its "
                                  f"transcript ({exc}) - resend with --force to "
                                  f"send unchecked")
        if flagged:
            return "unverified", ("entities not found in transcript, title or "
                                  "description: " + ", ".join(flagged[:8])
                                  + (" ..." if len(flagged) > 8 else "")
                                  + " - review, add channel repairs with "
                                    "`yth terms`, or resend with --force")

    footer = summary_footer(row["article_cost"], row["article_ms"]) or "Written by yth"
    try:
        recipient, message_id = send_summary_email(row, row["article"], footer, to=to)
    except Exception as exc:
        return "error", str(exc)

    now = int(datetime.now(timezone.utc).timestamp() * 1000)
    conn.execute(
        "UPDATE videos SET emailed_at = ?, emailed_to = ?, row_updated = ?"
        " WHERE video_id = ?", (now, recipient, now, video_id))
    conn.commit()
    return "sent", f"{recipient} ({message_id})"


def cmd_email(conn, video_id, to, force=False):
    state, detail = email_video_summary(conn, video_id, to=to, force=force)
    print(f"[{state}] {detail}")


# ---------------------------------------------------------------- tracked

# Discovery runs off the per-channel Atom feed rather than the Data API. It
# costs no quota, needs no OAuth (so it keeps working when the refresh token
# expires, which the API path does not), and carries title, description and
# publication time already. The only thing it lacks is duration, which the
# existing description backfill tops up when a token is available.
FEED_URL = "https://www.youtube.com/feeds/videos.xml?channel_id="
ATOM_NS = {
    "a": "http://www.w3.org/2005/Atom",
    "yt": "http://www.youtube.com/xml/schemas/2015",
    "m": "http://search.yahoo.com/mrss/",
}


def http_text(url, timeout=30, attempts=3):
    """Plain GET with a browser UA, retried on transient failures.

    Cloudflare fronts some of these endpoints and answers urllib's default
    User-Agent with 'error code: 1010', so the header is not optional.

    The retry is not belt-and-braces. YouTube's feed endpoint intermittently
    answers a perfectly valid channel with 404 or 500 when several are fetched
    in a row — observed on all four tracked channels at once, every one of which
    then succeeded on a manual retry seconds later. Without this, one blip marks
    a healthy channel as broken until the next poll half an hour later.
    """
    req = urllib.request.Request(url, headers={
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"})
    for attempt in range(attempts):
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.read().decode("utf-8", "replace")
        except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError):
            if attempt == attempts - 1:
                raise
            time.sleep(1.5 * (attempt + 1))


def resolve_channel(spec):
    """Turn a URL, @handle or raw UC id into (channel_id, handle, title).

    Deliberately scrape-based rather than channels.list?forHandle: tracking must
    keep working while the OAuth token is expired, and the page carries all
    three fields anyway.
    """
    spec = (spec or "").strip()
    if not spec:
        raise ValueError("empty channel")
    if re.fullmatch(r"UC[A-Za-z0-9_-]{22}", spec):
        url = f"https://www.youtube.com/channel/{spec}"
    elif spec.startswith("@"):
        url = f"https://www.youtube.com/{spec}"
    elif spec.startswith("http://") or spec.startswith("https://"):
        url = spec
    else:
        url = f"https://www.youtube.com/@{spec}"
    try:
        page = http_text(url)
    except urllib.error.HTTPError as exc:
        raise ValueError(f"channel page returned {exc.code}") from None
    except Exception as exc:
        raise ValueError(f"could not fetch channel page: {exc}") from None

    m = re.search(r'"(?:externalId|channelId)":"(UC[A-Za-z0-9_-]{22})"', page)
    if not m:
        m = re.search(r"channel_id=(UC[A-Za-z0-9_-]{22})", page)
    if not m:
        raise ValueError("no channel id on that page — is it a channel URL?")
    channel_id = m.group(1)

    handle = ""
    h = re.search(r'"canonicalBaseUrl":"/(@[A-Za-z0-9._-]+)"', page)
    if h:
        handle = h.group(1)
    elif spec.startswith("@"):
        handle = spec

    title = ""
    t = re.search(r'<meta property="og:title" content="([^"]*)"', page)
    if t:
        title = html.unescape(t.group(1))
    return channel_id, handle, title


def channel_id_from_video(video_id):
    """Scrape a watch page for its channel id.

    The Track pill needs this because `channel_url` is empty for the great
    majority of captured rows -- the extension does not record it and the
    description backfill never asked the API for `snippet.channelId`. Rather
    than a schema migration plus a full re-backfill (which needs a working
    token), resolve on demand from the one identifier every row does have.
    """
    page = http_text(f"https://www.youtube.com/watch?v={urllib.parse.quote(video_id)}")
    m = re.search(r'"channelId":"(UC[A-Za-z0-9_-]{22})"', page)
    if not m:
        m = re.search(r'<meta itemprop="channelId" content="(UC[A-Za-z0-9_-]{22})"', page)
    if not m:
        raise ValueError("no channel id on that video page")
    return m.group(1)


def fetch_channel_feed(channel_id):
    """Latest uploads for a channel as dicts. Newest first, up to 15."""
    raw = http_text(FEED_URL + channel_id)
    root = ET.fromstring(raw)
    feed_title = root.findtext("a:title", default="", namespaces=ATOM_NS)
    out = []
    for e in root.findall("a:entry", ATOM_NS):
        vid = e.findtext("yt:videoId", default="", namespaces=ATOM_NS)
        if not vid:
            continue
        group = e.find("m:group", ATOM_NS)
        desc = ""
        if group is not None:
            desc = group.findtext("m:description", default="",
                                  namespaces=ATOM_NS) or ""
        out.append({
            "video_id": vid,
            "title": e.findtext("a:title", default="", namespaces=ATOM_NS),
            "published": e.findtext("a:published", default="",
                                    namespaces=ATOM_NS),
            "description": desc,
            "channel": feed_title,
        })
    return out, feed_title


def add_tracked_channel(conn, spec):
    """Resolve and record a channel. Returns the row as a dict."""
    channel_id, handle, title = resolve_channel(spec)
    now = int(datetime.now(timezone.utc).timestamp() * 1000)
    existing = conn.execute(
        "SELECT channel_id FROM tracked_channels WHERE channel_id = ?",
        (channel_id,)).fetchone()
    conn.execute(
        "INSERT INTO tracked_channels (channel_id, handle, title, added_at,"
        " last_checked, active) VALUES (?, ?, ?, ?, 0, 1)"
        " ON CONFLICT(channel_id) DO UPDATE SET"
        "   handle = COALESCE(NULLIF(excluded.handle, ''), tracked_channels.handle),"
        "   title  = COALESCE(NULLIF(excluded.title, ''), tracked_channels.title),"
        "   active = 1",
        (channel_id, handle, title, now))
    conn.commit()
    return {"channelId": channel_id, "handle": handle, "title": title,
            "existing": existing is not None}


def refresh_tracked(conn, quiet=False, only=None, stale_minutes=None):
    """Poll tracked channels and record anything new.

    New uploads land in `videos` (so Robert/George/the glossary all work on
    them unchanged) AND in `tracked_items`. The two are deliberately separate:
    `videos.hidden` belongs to History and `tracked_items.cleared_at` belongs to
    Tracked, so clearing a notice never hides a video you might later watch.

    `stale_minutes` skips channels checked recently. Opening the tab uses it so
    a visit costs one or two fetches rather than one per tracked channel; the
    explicit Refresh button passes None and checks everything, which is what
    makes "I refreshed, so it is current" true.
    """
    say = (lambda *a: None) if quiet else print
    now = int(datetime.now(timezone.utc).timestamp() * 1000)
    where, params = "WHERE active = 1", []
    if only:
        where += " AND channel_id = ?"
        params.append(only)
    elif stale_minutes is not None:
        where += " AND COALESCE(last_checked, 0) < ?"
        params.append(now - stale_minutes * 60000)
    rows = conn.execute(
        f"SELECT channel_id, title, added_at FROM tracked_channels {where}",
        params).fetchall()
    checked = new = 0
    for ch in rows:
        cid = ch["channel_id"]
        try:
            entries, feed_title = fetch_channel_feed(cid)
        except Exception as exc:
            conn.execute("UPDATE tracked_channels SET last_error = ?,"
                         " last_checked = ?,"
                         " fail_count = COALESCE(fail_count, 0) + 1"
                         " WHERE channel_id = ?",
                         (str(exc)[:200], now, cid))
            conn.commit()
            say(f"  {ch['title'] or cid}: {exc}")
            continue
        checked += 1
        channel_url = ""
        hrow = conn.execute("SELECT handle FROM tracked_channels"
                            " WHERE channel_id = ?", (cid,)).fetchone()
        if hrow and hrow["handle"]:
            channel_url = f"https://www.youtube.com/{hrow['handle']}"
        for e in entries:
            seen = conn.execute("SELECT video_id FROM tracked_items"
                                " WHERE video_id = ?",
                                (e["video_id"],)).fetchone()
            published_ms = iso_to_ms(e["published"]) or now
            # A feed always carries the last 15 uploads, so adding a channel
            # would otherwise dump its whole back catalogue in as unread. Track
            # 20 channels and the tab opens with 300 notices, which is not what
            # "this channel published something new" means. Anything published
            # before you started tracking is recorded but pre-cleared: still
            # there under "Show cleared", just not shouting.
            seeded = 0 if published_ms >= (ch["added_at"] or 0) else now
            # Only descriptive fields are written, and only when the video row
            # does not already carry them: a video you have actually watched
            # must keep its captured position, watch count and timestamps.
            conn.execute(
                "INSERT INTO videos (video_id, title, channel, channel_url,"
                " duration, last_position, watched, watch_count, live,"
                " live_replay, first_seen, last_seen, source, row_updated,"
                " description, published_at)"
                # row_updated is 0, not `now`: a discovered-but-unwatched video
                # must not enter History's /recent feed. Actually watching it
                # makes touch() bump the stamp, and only then does it appear.
                " VALUES (?, ?, ?, ?, 0, 0, 0, 0, 0, 0, ?, ?, 'tracked', 0, ?, ?)"
                " ON CONFLICT(video_id) DO UPDATE SET"
                "   title = COALESCE(NULLIF(videos.title, ''), excluded.title),"
                "   channel = COALESCE(NULLIF(videos.channel, ''), excluded.channel),"
                "   channel_url = COALESCE(NULLIF(videos.channel_url, ''), excluded.channel_url),"
                "   description = COALESCE(NULLIF(videos.description, ''), excluded.description),"
                "   published_at = COALESCE(videos.published_at, excluded.published_at)",
                (e["video_id"], e["title"], feed_title or ch["title"] or "",
                 channel_url, published_ms, published_ms,
                 e["description"], e["published"]))
            conn.execute(
                "INSERT INTO tracked_items (video_id, channel_id, published_at,"
                " discovered_at, cleared_at, row_updated)"
                " VALUES (?, ?, ?, ?, ?, ?)"
                " ON CONFLICT(video_id) DO UPDATE SET"
                "   published_at = COALESCE(tracked_items.published_at, excluded.published_at)",
                (e["video_id"], cid, e["published"], now, seeded, now))
            if not seen and published_ms >= (ch["added_at"] or 0):
                new += 1
        conn.execute("UPDATE tracked_channels SET last_checked = ?, last_ok = ?,"
                     " last_error = NULL, fail_count = 0"
                     " WHERE channel_id = ?", (now, now, cid))
        conn.commit()
    say(f"checked {checked} channel(s), {new} new video(s)")
    return checked, new


def tracked_rows(conn, since, limit=1000):
    """Tracked items changed after `since`, newest publication first.

    Served on its own endpoint rather than folded into /recent: History's
    payload schema stays put (no forced resync of the whole table), and Stats
    cannot mistake an unwatched notice for watch time.
    """
    rows = conn.execute(
        "SELECT t.*, v.title, v.channel, v.channel_url, v.duration,"
        "       v.description, v.summary, v.summary_state, v.summary_cost,"
        "       v.summary_ms, v.emailed_at, v.emailed_to, v.watch_count"
        " FROM tracked_items t JOIN videos v ON v.video_id = t.video_id"
        " WHERE t.row_updated > ?"
        " ORDER BY t.row_updated ASC LIMIT ?",
        (since, limit)).fetchall()
    out = []
    for v in rows:
        out.append({
            "videoId": v["video_id"],
            "channelId": v["channel_id"],
            "title": v["title"] or "",
            "channel": v["channel"] or "",
            "channelUrl": v["channel_url"] or "",
            "duration": max(0, int(v["duration"] or 0)),
            "publishedAt": v["published_at"] or "",
            "discoveredAt": int(v["discovered_at"] or 0),
            "cleared": bool(v["cleared_at"]),
            "watchCount": int(v["watch_count"] or 0),
            "description": re.sub(r"\s+", " ", (v["description"] or "")).strip()[:400],
            "summary": flatten_summary(v["summary"]),
            "summaryMeta": summary_footer(v["summary_cost"], v["summary_ms"]),
            "summaryState": v["summary_state"] or "",
            "emailedAt": v["emailed_at"] or 0,
            "emailedTo": v["emailed_to"] or "",
        })
    cursor = rows[-1]["row_updated"] if rows else since
    return out, cursor


def tracked_channel_rows(conn):
    rows = conn.execute(
        "SELECT c.*, (SELECT COUNT(*) FROM tracked_items t"
        "             WHERE t.channel_id = c.channel_id AND t.cleared_at = 0)"
        "            AS pending"
        " FROM tracked_channels c ORDER BY LOWER(c.title), c.channel_id"
    ).fetchall()
    return [{
        "channelId": r["channel_id"], "handle": r["handle"] or "",
        "title": r["title"] or r["handle"] or r["channel_id"],
        "addedAt": r["added_at"] or 0, "lastChecked": r["last_checked"] or 0,
        "lastOk": r["last_ok"] or 0,
        "lastError": r["last_error"] or "",
        "failCount": r["fail_count"] or 0,
        # Reported as failing only after it has failed repeatedly. One bad
        # response from YouTube's feed endpoint is routine and self-corrects;
        # calling that "failing to check" is a false alarm on a healthy channel.
        "failing": (r["fail_count"] or 0) >= 3,
        "active": bool(r["active"]), "pending": r["pending"],
    } for r in rows]


def cmd_track(conn, action, value, quiet=False):
    if action == "add":
        info = add_tracked_channel(conn, value)
        verb = "already tracked, re-enabled" if info["existing"] else "tracked"
        print(f"{verb}: {info['title'] or info['handle'] or info['channelId']}"
              f"  ({info['channelId']})")
        refresh_tracked(conn, only=info["channelId"])
        return
    if action == "remove":
        row = conn.execute(
            "SELECT channel_id FROM tracked_channels"
            " WHERE channel_id = ? OR handle = ? OR LOWER(title) = LOWER(?)",
            (value, value, value)).fetchone()
        if not row:
            sys.exit(f"not tracking: {value}")
        # Items are left in place; they are still legitimate history rows and
        # the notice list simply stops gaining new ones.
        conn.execute("DELETE FROM tracked_channels WHERE channel_id = ?",
                     (row["channel_id"],))
        conn.commit()
        print(f"untracked {row['channel_id']}")
        return
    if action == "refresh":
        refresh_tracked(conn)
        return
    if action == "subs":
        rows = conn.execute("SELECT channel_id, title FROM subscriptions"
                            " WHERE present = 1 ORDER BY LOWER(title)").fetchall()
        if not rows:
            sys.exit("No subscriptions synced yet. Run:  yth subs sync")
        for r in rows:
            print(f"{r['channel_id']}  {r['title']}")
        print(f"\n{len(rows)} subscriptions")
        return
    # list
    rows = tracked_channel_rows(conn)
    if not rows:
        print("No tracked channels. Add one with:  yth track add @handle")
        return
    for r in rows:
        when = (datetime.fromtimestamp(r["lastChecked"] / 1000, PERTH)
                .strftime("%d %b %H:%M") if r["lastChecked"] else "never")
        flag = "" if r["active"] else "  [paused]"
        err = (f"  !! failed {r['failCount']}x: {r['lastError']}"
               if r["failing"] else "")
        print(f"{r['title'][:40]:<40} {r['pending']:>3} new   checked {when}"
              f"{flag}{err}")
    print(f"\n{len(rows)} tracked channel(s)")


# ---------------------------------------------------------------- subscriptions

# Half the default 10,000/day allocation. A bug in the unsub worker can then
# cost at most half a day's quota, and reads (likes sync, backfill, tracked)
# keep working on the other half -- which is why the budget is checked ONLY on
# the write path.
QUOTA_BUDGET = 5000
UNSUB_COST = 50
# One removal a minute. At the budget that is 100/day, which the budget caps
# anyway; the gap exists so a queue of 200 does not arrive as a burst.
UNSUB_INTERVAL_SECONDS = 60
# Activity checks read the channel's Atom feed, which costs no quota. Re-checked
# weekly: "have they posted in years" does not change hourly.
ACTIVITY_STALE_HOURS = 168


def sync_subscriptions(conn, quiet=False):
    """Pull the subscription list and merge it into the record.

    part=snippet alone carries title, description, thumbnail, the channel id and
    the date YOU subscribed -- so the whole list costs 1 unit per 50 channels
    and no second call is needed for the UI.
    """
    say = (lambda *a: None) if quiet else print
    token = access_token()
    items, page = [], None
    while True:
        params = {"part": "snippet", "mine": "true", "maxResults": 50,
                  "order": "alphabetical"}
        if page:
            params["pageToken"] = page
        data = api_get("subscriptions", params, token)
        items.extend(data.get("items", []))
        page = data.get("nextPageToken")
        if not page:
            break

    now = int(datetime.now(timezone.utc).timestamp() * 1000)
    seen = set()
    for it in items:
        sn = it.get("snippet") or {}
        cid = (sn.get("resourceId") or {}).get("channelId")
        if not cid:
            continue
        seen.add(cid)
        thumbs = sn.get("thumbnails") or {}
        thumb = ((thumbs.get("medium") or thumbs.get("default") or {}).get("url") or "")
        conn.execute(
            "INSERT INTO subscriptions (channel_id, sub_id, title, description,"
            " thumbnail, subscribed_at, synced_at, present)"
            " VALUES (?, ?, ?, ?, ?, ?, ?, 1)"
            " ON CONFLICT(channel_id) DO UPDATE SET"
            "   sub_id = excluded.sub_id, title = excluded.title,"
            "   description = excluded.description, thumbnail = excluded.thumbnail,"
            "   subscribed_at = COALESCE(subscriptions.subscribed_at, excluded.subscribed_at),"
            "   synced_at = excluded.synced_at, present = 1",
            (cid, it.get("id"), sn.get("title") or "", sn.get("description") or "",
             thumb, sn.get("publishedAt") or "", now))
    # Anything no longer returned has been unsubscribed -- by this tool or in the
    # YouTube UI. Kept as a row so a completed removal stays visible and
    # auditable rather than silently vanishing.
    if seen:
        placeholders = ",".join("?" * len(seen))
        # Rows the queue owns are exempt. A sync that pages short would
        # otherwise flip a queued row to present = 0, and queue_unsub's
        # `present = 1` guard would then silently refuse to re-queue it -- a
        # pending removal that can never run and gives no reason why.
        conn.execute(
            f"UPDATE subscriptions SET present = 0"
            f" WHERE channel_id NOT IN ({placeholders})"
            f"   AND COALESCE(unsub_state,'') NOT IN ('queued','sent')",
            list(seen))
    conn.commit()
    say(f"  {len(seen)} subscriptions synced")
    return len(seen)


def refresh_subscription_activity(conn, limit=40, quiet=False, only=None):
    """Fill in "when did this channel last post" from its Atom feed.

    Zero quota -- the whole point, since asking the API for 493 channels' latest
    upload would cost 493 units a pass. Staleness-gated and capped per call so
    the background loop trickles through the list instead of firing 493 requests
    at once, which is exactly what drew spurious 404s on the Tracked feeds.
    """
    say = (lambda *a: None) if quiet else print
    now = int(datetime.now(timezone.utc).timestamp() * 1000)
    if only:
        rows = conn.execute(
            "SELECT channel_id, title FROM subscriptions WHERE channel_id = ?",
            (only,)).fetchall()
    else:
        rows = conn.execute(
            "SELECT channel_id, title FROM subscriptions"
            " WHERE present = 1 AND COALESCE(unsub_state,'') NOT IN ('done','sent')"
            "   AND COALESCE(activity_at, 0) < ?"
            " ORDER BY COALESCE(activity_at, 0) ASC LIMIT ?",
            (now - ACTIVITY_STALE_HOURS * 3600000, limit)).fetchall()
    checked = 0
    for r in rows:
        cid = r["channel_id"]
        try:
            entries, _ = fetch_channel_feed(cid)
        except Exception as exc:
            conn.execute(
                "UPDATE subscriptions SET activity_at = ?, activity_error = ?"
                " WHERE channel_id = ?", (now, str(exc)[:160], cid))
            conn.commit()
            continue
        latest = max((e["published"] for e in entries), default="")
        conn.execute(
            "UPDATE subscriptions SET last_upload_at = ?, upload_count = ?,"
            " activity_at = ?, activity_error = NULL WHERE channel_id = ?",
            (latest, len(entries), now, cid))
        conn.commit()
        checked += 1
    say(f"  activity checked for {checked} channel(s)")
    return checked


def backfill_channel_ids(conn, limit=200, quiet=False):
    """Attach snippet.channelId to watched videos.

    Without this, "when did I last watch this channel" has to match on display
    name, which is fuzzy and breaks on a rename. videos.list already returns the
    id on the call the description backfill makes, so this is the same 1 unit
    per 50 videos and no new API surface.
    """
    say = (lambda *a: None) if quiet else print
    pending = [r["video_id"] for r in conn.execute(
        "SELECT video_id FROM videos WHERE channel_id IS NULL"
        " ORDER BY last_seen DESC LIMIT ?", (limit,))]
    if not pending:
        return 0
    token = access_token()
    found = 0
    for i in range(0, len(pending), 50):
        chunk = pending[i:i + 50]
        data = api_get("videos", {"part": "snippet", "id": ",".join(chunk)}, token)
        got = {item["id"]: (item.get("snippet") or {}).get("channelId") or ""
               for item in data.get("items") or []}
        # One transaction per 50-video chunk, not one per row. A row-at-a-time
        # loop holds the write lock across the whole batch and loses to the
        # daemon's likes sync, which can hold it for tens of seconds.
        conn.executemany(
            "UPDATE videos SET channel_id = ? WHERE video_id = ?",
            # "" rather than left NULL for videos the API will not return, so a
            # deleted video is not re-queried on every pass forever.
            [(got.get(vid, ""), vid) for vid in chunk])
        conn.commit()
        found += sum(1 for vid in chunk if got.get(vid))
    say(f"  channel ids: {len(pending)} checked, {found} resolved")
    return found


def _norm_channel(name):
    return re.sub(r"[^a-z0-9]", "", (name or "").lower())


def subscription_rows(conn):
    """Every subscription, joined to what the record knows about engagement.

    The engagement figures are honest about their own provenance. Real watch
    data only exists from when the extension was installed; likes go back years.
    `lastViewed` is therefore the later of "last watched" and "last liked", and
    `lastViewedKind` says which one it actually is, so the UI can label the
    column for what it measures rather than implying it saw you watch something
    in 2015.
    """
    # Exact match on channel_id where the backfill has supplied it, falling back
    # to a normalised display name for rows it has not reached yet.
    by_id, by_name = {}, {}
    for r in conn.execute(
            "SELECT v.channel_id, v.channel, v.video_id, l.liked_at,"
            "       (SELECT COALESCE(MAX(s.watched_at), 0) FROM sessions s"
            "         WHERE s.video_id = v.video_id) AS watched_at"
            "  FROM videos v LEFT JOIN likes l ON l.video_id = v.video_id"
            " WHERE NOT " + UNWATCHED_TRACKED):
        stat = {"videos": 0, "likes": 0, "watched": 0,
                "last_like": 0, "last_watch": 0}
        for bucket, key in ((by_id, r["channel_id"]), (by_name, _norm_channel(r["channel"]))):
            if not key:
                continue
            st = bucket.setdefault(key, dict(stat))
            st["videos"] += 1
            if r["liked_at"]:
                st["likes"] += 1
                st["last_like"] = max(st["last_like"], r["liked_at"])
            if r["watched_at"]:
                st["watched"] += 1
                st["last_watch"] = max(st["last_watch"], r["watched_at"])

    tracked = {r["channel_id"] for r in conn.execute(
        "SELECT channel_id FROM tracked_channels")}

    out = []
    for r in conn.execute("SELECT * FROM subscriptions ORDER BY LOWER(title)"):
        st = by_id.get(r["channel_id"]) or by_name.get(_norm_channel(r["title"])) \
            or {"videos": 0, "likes": 0, "watched": 0, "last_like": 0, "last_watch": 0}
        last_watch, last_like = st["last_watch"], st["last_like"]
        if last_watch >= last_like and last_watch:
            last_viewed, kind = last_watch, "watched"
        elif last_like:
            last_viewed, kind = last_like, "liked"
        else:
            last_viewed, kind = 0, "never"
        out.append({
            "channelId": r["channel_id"],
            "subId": r["sub_id"] or "",
            "title": r["title"] or "",
            "description": re.sub(r"\s+", " ", (r["description"] or "")).strip()[:400],
            "thumbnail": r["thumbnail"] or "",
            "subscribedAt": r["subscribed_at"] or "",
            "lastUploadAt": r["last_upload_at"] or "",
            "uploadCount": r["upload_count"] or 0,
            "activityChecked": r["activity_at"] or 0,
            "activityError": r["activity_error"] or "",
            "lastViewed": last_viewed,
            "lastViewedKind": kind,
            "videos": st["videos"], "likes": st["likes"], "watched": st["watched"],
            "tracked": r["channel_id"] in tracked,
            "present": bool(r["present"]),
            "unsubState": r["unsub_state"] or "",
            "unsubQueuedAt": r["unsub_queued_at"] or 0,
            "unsubError": r["unsub_error"] or "",
        })
    return out


def queue_warnings(conn, channel_ids):
    """Queued channels you may not have meant to drop.

    Queueing is a bulk action with no per-row confirmation, by design -- the
    point is to select a lot at once. So the warning comes after the fact and
    before the minute elapses: a channel you track, or have liked videos from,
    is one mis-click from an irreversible removal otherwise.
    """
    if not channel_ids:
        return []
    marks = ",".join("?" * len(channel_ids))
    rows = conn.execute(
        f"SELECT s.channel_id, s.title,"
        f"  (SELECT COUNT(*) FROM tracked_channels t"
        f"    WHERE t.channel_id = s.channel_id) AS tracked,"
        f"  (SELECT COUNT(*) FROM videos v JOIN likes l ON l.video_id = v.video_id"
        f"    WHERE v.channel_id = s.channel_id) AS likes"
        f" FROM subscriptions s WHERE s.channel_id IN ({marks})",
        list(channel_ids)).fetchall()
    out = []
    for r in rows:
        why = []
        if r["tracked"]:
            why.append("on the Tracked tab")
        if r["likes"]:
            why.append(f"{r['likes']} liked video(s)")
        if why:
            out.append({"channelId": r["channel_id"], "title": r["title"] or "",
                        "why": " and ".join(why)})
    return out


def queue_unsub(conn, channel_ids, cancel=False):
    """Mark channels for removal, or take them back off the queue.

    Nothing is sent here. The worker drains the queue slowly and within budget,
    which is what makes "select a lot and let it run" safe: until a row reaches
    'sent' it can still be cancelled.
    """
    now = int(datetime.now(timezone.utc).timestamp() * 1000)
    changed = 0
    for cid in channel_ids:
        if cancel:
            cur = conn.execute(
                "UPDATE subscriptions SET unsub_state = NULL, unsub_queued_at = 0,"
                " unsub_error = NULL"
                " WHERE channel_id = ? AND unsub_state = 'queued'", (cid,))
        else:
            # Only a live subscription can be queued, and never one already sent:
            # re-queueing a completed removal would spend 50 units on a 404.
            cur = conn.execute(
                "UPDATE subscriptions SET unsub_state = 'queued', unsub_queued_at = ?,"
                " unsub_error = NULL"
                " WHERE channel_id = ? AND present = 1"
                "   AND COALESCE(unsub_state,'') NOT IN ('queued','sent','done')",
                (now, cid))
        changed += cur.rowcount
    conn.commit()
    return changed


def unsub_budget(conn):
    """What the write path is allowed to spend right now, and what is stopping it.

    `blocked` matters as much as the numbers: a queue that cannot run because
    the write scope was never authorised looks identical, from the UI, to one
    that is simply waiting its turn.
    """
    used, _ = quota_spent(conn)
    remaining = max(0, QUOTA_BUDGET - used)
    pending = conn.execute("SELECT COUNT(*) FROM subscriptions"
                           " WHERE unsub_state = 'queued'").fetchone()[0]
    blocked, detail = "", ""
    if pending and not WRITE_CREDS_PATH.exists():
        blocked = "auth"
        detail = ("Unsubscribing is not authorised yet. Run"
                  " `yth auth --write --from-env` and approve in the browser;"
                  " the queue starts on its own afterwards.")
    elif pending and remaining < UNSUB_COST:
        blocked = "budget"
        detail = (f"Daily quota budget reached ({used}/{QUOTA_BUDGET} units)."
                  f" The queue resumes after midnight US Pacific.")
    return {"day": pacific_day(), "used": used, "budget": QUOTA_BUDGET,
            "remaining": remaining, "unsubsLeft": remaining // UNSUB_COST,
            "pending": pending, "blocked": blocked, "blockedDetail": detail}


def drain_unsub_queue(conn, max_items=1, quiet=False):
    """Send at most `max_items` queued removals, honouring the daily budget.

    Deliberately one at a time by default: the caller is a background loop with
    a minute between passes, so a queue of 200 is spread over hours instead of
    arriving as a burst that trips rate limits.
    """
    say = (lambda *a: None) if quiet else print
    sent, blocked = 0, None
    for _ in range(max_items):
        budget = unsub_budget(conn)
        if budget["remaining"] < UNSUB_COST:
            blocked = "budget"
            break
        row = conn.execute(
            "SELECT channel_id, sub_id, title FROM subscriptions"
            " WHERE unsub_state = 'queued' ORDER BY unsub_queued_at ASC LIMIT 1"
        ).fetchone()
        if not row:
            break

        # Re-verify the subscription id immediately before use. It changes if
        # you unsubscribe and resubscribe, and a stale id would spend 50 units
        # to delete nothing -- or, worse, something else.
        try:
            token = access_token(WRITE_CREDS_PATH)
        except SystemExit as exc:
            conn.execute("UPDATE subscriptions SET unsub_error = ?"
                         " WHERE channel_id = ?", (str(exc)[:200], row["channel_id"]))
            conn.commit()
            blocked = "auth"
            break

        live = api_get("subscriptions", {"part": "snippet", "mine": "true",
                                         "forChannelId": row["channel_id"],
                                         "maxResults": 1}, token)
        items = live.get("items") or []
        if not items:
            # Already gone -- unsubscribed in the YouTube UI, or a previous send
            # that succeeded before we recorded it. Not an error, and not worth
            # 50 units to confirm.
            conn.execute(
                "UPDATE subscriptions SET unsub_state = 'done', present = 0,"
                " unsub_done_at = ?, unsub_error = NULL WHERE channel_id = ?",
                (int(datetime.now(timezone.utc).timestamp() * 1000), row["channel_id"]))
            conn.commit()
            say(f"  already gone: {row['title']}")
            continue

        sub_id = items[0]["id"]
        conn.execute("UPDATE subscriptions SET unsub_state = 'sent', sub_id = ?"
                     " WHERE channel_id = ?", (sub_id, row["channel_id"]))
        conn.commit()
        # Debit BEFORE the call. A crash between issuing the delete and
        # recording its cost would otherwise lose the 50 units, and the next
        # start would re-spend them.
        record_quota(UNSUB_COST, "subscriptions.delete")
        try:
            api_delete("subscriptions", {"id": sub_id}, token)
        except Exception as exc:
            conn.execute(
                "UPDATE subscriptions SET unsub_state = 'failed', unsub_error = ?"
                " WHERE channel_id = ?", (str(exc)[:200], row["channel_id"]))
            conn.commit()
            say(f"  FAILED {row['title']}: {exc}")
            blocked = "error"
            break
        conn.execute(
            "UPDATE subscriptions SET unsub_state = 'done', present = 0,"
            " unsub_done_at = ?, unsub_error = NULL WHERE channel_id = ?",
            (int(datetime.now(timezone.utc).timestamp() * 1000), row["channel_id"]))
        conn.commit()
        sent += 1
        # Logged with the title, not just an id: this is the audit trail for an
        # irreversible change made on the user's behalf, possibly days after
        # they asked for it.
        say(f"  unsubscribed: {row['title']} ({row['channel_id']})")
    return sent, blocked


def cmd_subs(conn, action, value=None):
    if action == "sync":
        sync_subscriptions(conn)
        return
    if action == "activity":
        refresh_subscription_activity(conn, limit=int(value) if value else 40)
        return
    if action == "queue":
        n = queue_unsub(conn, [value])
        print(f"queued {n}")
        return
    if action == "cancel":
        if value:
            n = queue_unsub(conn, [value], cancel=True)
        else:
            n = conn.execute(
                "UPDATE subscriptions SET unsub_state = NULL, unsub_queued_at = 0"
                " WHERE unsub_state = 'queued'").rowcount
            conn.commit()
        print(f"cancelled {n}")
        return
    if action == "drain":
        sent, blocked = drain_unsub_queue(conn, max_items=int(value) if value else 1)
        print(f"sent {sent}" + (f", stopped: {blocked}" if blocked else ""))
        return
    if action == "quota":
        b = unsub_budget(conn)
        used, calls = quota_spent(conn)
        print(f"quota day {b['day']} (resets midnight US Pacific)")
        print(f"  spent   {used} of {b['budget']} budgeted ({calls} calls)")
        print(f"  allows  {b['unsubsLeft']} more unsubscribe(s) today")
        return
    # list
    rows = subscription_rows(conn)
    if not rows:
        print("No subscriptions synced yet. Run:  yth subs sync")
        return
    queued = [r for r in rows if r["unsubState"] == "queued"]
    never = [r for r in rows if r["lastViewedKind"] == "never"]
    dormant = [r for r in rows if r["lastUploadAt"]
               and iso_to_ms(r["lastUploadAt"]) < int(
                   (datetime.now(timezone.utc) - timedelta(days=365)).timestamp() * 1000)]
    print(f"{len(rows)} subscriptions"
          f" · {len(never)} never viewed"
          f" · {len(dormant)} dormant (no upload in a year)"
          f" · {len(queued)} queued to unsubscribe")
    for r in sorted(rows, key=lambda r: r["lastViewed"]):
        when = (datetime.fromtimestamp(r["lastViewed"] / 1000, PERTH).strftime("%b %Y")
                if r["lastViewed"] else "never")
        up = r["lastUploadAt"][:10] if r["lastUploadAt"] else "?"
        flag = " [queued]" if r["unsubState"] == "queued" else ""
        print(f"  {r['title'][:38]:<38} viewed {when:<9} ({r['lastViewedKind']:<7})"
              f" last upload {up}{flag}")


# ---------------------------------------------------------------- daemon

TOKEN_PATH = CONFIG_DIR / "daemon-token"
DEFAULT_PORT = 8742

# Bump whenever a field is ADDED to or changed in the /recent payload. Clients
# store the version they last merged; on a mismatch they reset their cursor and
# re-pull everything, because rows they already consumed are otherwise never
# re-sent and would keep the old shape forever. Adding a field without bumping
# this is the bug that has bitten three times: description, summary, summaryMeta.
PAYLOAD_SCHEMA = 5
# Tracked has its own payload version, deliberately independent of History's.
# Changing the notice list must never force a resync of the 1,300-row watch
# history, and vice versa.
TRACKED_SCHEMA = 1
# How often the daemon polls the Atom feeds. Feeds are cheap but not free to
# YouTube, and channels do not publish more than a few times a day.
TRACKED_POLL_MINUTES = 30
# Opening the Tracked tab polls only channels staler than this, so a visit with
# 30 channels tracked is one or two fetches rather than thirty serial ones.
TRACKED_STALE_MINUTES = 15
# Independent of History's and Tracked's, for the same reason those are
# independent of each other.
SUBS_SCHEMA = 1
# The cursor and the 500-row page cap bound each response, so this window only
# needs to be wide enough to cover anything the History tab still shows. At 21
# days, rows older than that could never receive later enrichment (descriptions
# were added long after most rows were first synced) and stayed blank forever.
# Effectively unbounded: the cursor and the 500-row page cap are what bound a
# response. A tighter window silently strips rows that clients then never see
# enrichment for -- at 3650 days it quietly dropped the oldest 2015 likes.
# Narrow it deliberately (?days=N) if you ever want the extension to hold less.
SERVE_WINDOW_DAYS = 36500


def daemon_token():
    """Shared secret the extension must present.

    Localhost alone is not access control: any page you visit can issue a
    cross-origin POST to 127.0.0.1. Requiring a custom header forces a CORS
    preflight, which we only answer for chrome-extension:// origins.
    """
    if TOKEN_PATH.exists():
        return TOKEN_PATH.read_text().strip()
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tok = secrets.token_urlsafe(24)
    TOKEN_PATH.write_text(tok)
    TOKEN_PATH.chmod(0o600)
    return tok


def touch(conn, video_ids):
    now = int(datetime.now(timezone.utc).timestamp() * 1000)
    conn.executemany("UPDATE videos SET row_updated = ? WHERE video_id = ?",
                     [(now, v) for v in video_ids])


def ingest_records(conn, videos, sessions, events):
    """Merge a push from the extension. Same rules as a file import."""
    payload = {"history": videos, "watchSessions": sessions, "watchEvents": events}
    tmp = CONFIG_DIR / "ingest.tmp.json"
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp.write_text(json.dumps(payload))
    try:
        new_v, new_s, new_e, *_ = do_import(conn, tmp)
    finally:
        tmp.unlink(missing_ok=True)
    touch(conn, [video_id_of(v) for v in videos if video_id_of(v)])
    conn.commit()
    return new_v, new_s, new_e


def flatten_summary(text):
    """Markdown to one readable line for the History column.

    The model answers in markdown; the column sets textContent, so asterisks
    would show literally. Bullets become "* " so the structure survives the
    three-line clamp. The raw markdown stays in the record for any richer UI.
    """
    if not text:
        return ""
    out = re.sub(r"\*\*(.+?)\*\*", r"\1", text)          # bold
    out = re.sub(r"(?m)^\s*[-*\u2022]\s+", "\u2022 ", out)  # list markers
    out = re.sub(r"(?m)^#{1,6}\s*", "", out)                # headings
    out = re.sub(r"\s*\n\s*", "  ", out)
    return re.sub(r"\s{3,}", "  ", out).strip()


def serve_rows(conn, since, days):
    """Rows changed after `since`, limited to the retention window."""
    cutoff = int((datetime.now(PERTH) - timedelta(days=days)).timestamp() * 1000)
    rows = conn.execute(
        "SELECT v.*, l.video_id IS NOT NULL AS liked FROM videos v"
        " LEFT JOIN likes l ON l.video_id = v.video_id"
        " WHERE v.row_updated > ? AND v.last_seen >= ?"
        " ORDER BY v.row_updated ASC LIMIT 500",
        (since, cutoff)).fetchall()
    out = []
    for v in rows:
        out.append({
            "videoId": v["video_id"], "title": v["title"] or "",
            "channel": v["channel"] or "", "channelUrl": v["channel_url"] or "",
            "time": max(0, min(86400, int(v["last_position"] or 0))),
            "duration": max(0, int(v["duration"] or 0)),
            "watched": bool(v["watched"]), "watchCount": int(v["watch_count"] or 0),
            "timestamp": int(v["last_seen"] or 0),
            "liked": bool(v["liked"]), "hidden": bool(v["hidden"]),
            # Trimmed and flattened for the wire: the column clamps to three
            # lines, and a description's own blank lines would otherwise eat
            # them. Full text stays in the record.
            "description": re.sub(r"\s+", " ", (v["description"] or "")).strip()[:400],
            # Sent in full: a summary is short by construction and is the
            # primary thing the row displays once it exists.
            "summary": flatten_summary(v["summary"]),
            "summaryMeta": summary_footer(v["summary_cost"], v["summary_ms"]),
            "emailedAt": v["emailed_at"] or 0,
            "emailedTo": v["emailed_to"] or "",
            "summaryState": v["summary_state"] or "",
            **({"live": True} if v["live"] else {}),
            **({"liveReplay": True} if v["live_replay"] else {}),
        })
    cursor = rows[-1]["row_updated"] if rows else since
    return out, cursor


def cmd_serve(db_path, port, sync_minutes):
    token = daemon_token()
    print(f"Token: {token}")
    print(f"       (paste into the extension's options page; also at {TOKEN_PATH})")

    lock = threading.Lock()
    # Separate from `lock`: a refresh is N sequential feed fetches, and running
    # two at once (the 30-minute loop firing while you click Refresh) would
    # double the requests to YouTube for identical results. Non-blocking, so a
    # click during a background poll returns immediately rather than hanging.
    tracked_lock = threading.Lock()
    subs_lock = threading.Lock()

    def open_conn():
        c = connect(db_path)
        c.execute("PRAGMA journal_mode=WAL")
        return c

    def likes_loop():
        while True:
            try:
                with lock:
                    c = open_conn()
                    before = c.execute("SELECT COUNT(*) FROM likes").fetchone()[0]
                    cmd_sync_likes(c, quiet=True)
                    after = c.execute("SELECT COUNT(*) FROM likes").fetchone()[0]
                    # Surface newly-liked videos to clients even though the like
                    # itself does not change the videos row.
                    c.execute(
                        "UPDATE videos SET row_updated = ? WHERE video_id IN"
                        " (SELECT video_id FROM likes)"
                        " AND row_updated < (SELECT liked_at FROM likes"
                        "                    WHERE likes.video_id = videos.video_id)",
                        (int(datetime.now(timezone.utc).timestamp() * 1000),))
                    c.commit()
                    # Backfill BEFORE closing. This previously ran after
                    # c.close() and failed every cycle with "Cannot operate on a
                    # closed database", so descriptions were never topped up in
                    # the background at all -- only ever by an explicit
                    # `yth backfill`.
                    _, filled = backfill_descriptions(c, limit=200, quiet=True)
                    c.commit()
                    ids = backfill_channel_ids(c, limit=200, quiet=True)
                    c.commit()
                    c.close()
                    stamp = datetime.now(PERTH).strftime("%H:%M")
                    if after != before:
                        print(f"[{stamp}] likes: +{after - before}")
                    if filled:
                        print(f"[{stamp}] descriptions: +{filled}")
                    if ids:
                        print(f"[{stamp}] channel ids: +{ids}")
            except SystemExit as exc:
                print(f"[likes] sync failed: {exc}")
            except Exception as exc:
                print(f"[likes] error: {exc}")
            __import__("time").sleep(max(60, sync_minutes * 60))

    def tracked_loop():
        # Separate thread from likes_loop on purpose: feed polling needs no
        # OAuth, so an expired refresh token must not stop it.
        while True:
            try:
                if not tracked_lock.acquire(blocking=False):
                    checked = new = 0          # a manual Refresh is already running
                else:
                    try:
                        c = open_conn()
                        try:
                            checked, new = refresh_tracked(c, quiet=True)
                        finally:
                            c.close()
                    finally:
                        tracked_lock.release()
                if new:
                    stamp = datetime.now(PERTH).strftime("%H:%M")
                    print(f"[{stamp}] tracked: +{new} from {checked} channel(s)")
            except Exception as exc:
                print(f"[tracked] error: {exc}")
            __import__("time").sleep(TRACKED_POLL_MINUTES * 60)

    def subs_loop():
        """Trickle work that must not arrive as a burst.

        Activity checks are free but are 491 HTTP requests, so they go a few at
        a time. Unsubscribes are irreversible and metered, so exactly one per
        pass -- a queue of 200 spreads over hours rather than hitting the API as
        a block, and there is a minute in which to cancel between each one.
        """
        warned_day = None
        while True:
            try:
                c = open_conn()
                try:
                    refresh_subscription_activity(c, limit=8, quiet=True)
                    if subs_lock.acquire(blocking=False):
                        try:
                            sent, blocked = drain_unsub_queue(c, max_items=1, quiet=False)
                        finally:
                            subs_lock.release()
                        budget = unsub_budget(c)
                        pending = c.execute(
                            "SELECT COUNT(*) FROM subscriptions"
                            " WHERE unsub_state = 'queued'").fetchone()[0]
                        # Warned once per quota day, not once per minute: the
                        # loop would otherwise fill the log with the same line
                        # every 60 seconds for the rest of the day.
                        if (blocked == "budget" and pending
                                and warned_day != budget["day"]):
                            warned_day = budget["day"]
                            stamp = datetime.now(PERTH).strftime("%H:%M")
                            print(f"[{stamp}] QUOTA BUDGET REACHED"
                                  f" ({budget['used']}/{budget['budget']} units)."
                                  f" {pending} unsubscribe(s) still queued; they"
                                  f" resume after midnight US Pacific.")
                            notify_budget_reached(budget, pending)
                finally:
                    c.close()
            except Exception as exc:
                print(f"[subs] error: {exc}")
            __import__("time").sleep(UNSUB_INTERVAL_SECONDS)

    threading.Thread(target=likes_loop, daemon=True).start()
    threading.Thread(target=tracked_loop, daemon=True).start()
    threading.Thread(target=subs_loop, daemon=True).start()

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "yth"

        def _cors(self):
            origin = self.headers.get("Origin", "")
            if origin.startswith("chrome-extension://") or origin.startswith("moz-extension://"):
                self.send_header("Access-Control-Allow-Origin", origin)
                self.send_header("Access-Control-Allow-Headers", "Content-Type, X-YTH-Token")
                self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")

        def _authed(self):
            if self.headers.get("X-YTH-Token") == token:
                return True
            self.send_response(403); self._cors(); self.end_headers()
            self.wfile.write(b'{"error":"bad token"}')
            return False

        def _json(self, obj, code=200):
            body = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self._cors(); self.end_headers(); self.wfile.write(body)

        def do_OPTIONS(self):
            self.send_response(204); self._cors(); self.end_headers()

        def do_GET(self):
            u = urllib.parse.urlparse(self.path)
            q = urllib.parse.parse_qs(u.query)
            if u.path == "/health":
                return self._json({"ok": True, "service": "yth"})
            if not self._authed():
                return
            if u.path == "/recent":
                since = int((q.get("since") or ["0"])[0])
                days = int((q.get("days") or [SERVE_WINDOW_DAYS])[0])
                # Deliberately lock-free. The likes sync and description
                # backfill can hold the write lock for tens of seconds, and
                # queueing reads behind them would hang the History tab every
                # time one ran. WAL gives readers a consistent snapshot without
                # blocking the writer.
                c = open_conn()
                try:
                    rows, cursor = serve_rows(c, since, days)
                finally:
                    c.close()
                return self._json({"videos": rows, "cursor": cursor,
                                   "count": len(rows), "schema": PAYLOAD_SCHEMA})
            if u.path == "/tracked":
                since = int((q.get("since") or ["0"])[0])
                limit = 1000
                c = open_conn()
                try:
                    rows, cursor = tracked_rows(c, since, limit)
                    channels = tracked_channel_rows(c)
                finally:
                    c.close()
                # `more` rather than a silent truncation: the client pages on
                # the cursor until it is false.
                return self._json({"videos": rows, "cursor": cursor,
                                   "count": len(rows), "channels": channels,
                                   "more": len(rows) == limit,
                                   "schema": TRACKED_SCHEMA})
            if u.path == "/subs":
                c = open_conn()
                try:
                    rows = subscription_rows(c)
                    budget = unsub_budget(c)
                finally:
                    c.close()
                return self._json({"subscriptions": rows, "count": len(rows),
                                   "budget": budget, "schema": SUBS_SCHEMA})
            if u.path == "/subs-quota":
                c = open_conn()
                try:
                    return self._json(unsub_budget(c))
                finally:
                    c.close()
            if u.path == "/tracked-channels":
                c = open_conn()
                try:
                    return self._json({"channels": tracked_channel_rows(c)})
                finally:
                    c.close()
            if u.path == "/subscriptions":
                # Served from the synced table when there is one: the Tracked
                # picker used to spend 10 quota units re-listing 491 channels
                # every time it was opened, for a list the Subscriptions tab
                # already keeps current. Falls back to a live call so the
                # picker still works before the first sync.
                c = open_conn()
                try:
                    rows = c.execute(
                        "SELECT channel_id, title FROM subscriptions"
                        " WHERE present = 1 ORDER BY LOWER(title)").fetchall()
                finally:
                    c.close()
                if rows:
                    return self._json({"subscriptions": [
                        {"channelId": r["channel_id"], "title": r["title"] or ""}
                        for r in rows]})
                return self._json({"error": "No subscriptions synced yet."
                                            " Open the Subscriptions tab and"
                                            " press Sync from YouTube."}, 200)
            self._json({"error": "not found"}, 404)

        def do_POST(self):
            u = urllib.parse.urlparse(self.path)
            if not self._authed():
                return
            length = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(length) or b"{}")
            except json.JSONDecodeError:
                return self._json({"error": "bad json"}, 400)

            if u.path == "/ingest":
                with lock:
                    c = open_conn()
                    try:
                        nv, ns, ne = ingest_records(
                            c, body.get("videos") or [], body.get("sessions") or [],
                            body.get("events") or [])
                    except ExportFormatError as exc:
                        c.close()
                        return self._json({"error": str(exc)}, 400)
                    c.close()
                return self._json({"newVideos": nv, "newSessions": ns, "newEvents": ne})

            if u.path == "/summarize":
                vid = body.get("videoId")
                if not vid:
                    return self._json({"error": "videoId required"}, 400)
                # Deliberately outside `lock`: this runs a subprocess and an LLM
                # call, ~5-10s, and holding the write lock for that would stall
                # every ingest and pull from both browsers.
                c = open_conn()
                try:
                    state, text = summarise_video(c, vid)
                finally:
                    c.close()
                stamp = datetime.now(PERTH).strftime("%H:%M")
                print(f"[{stamp}] summarise {vid}: {state}")
                if state == "ok":
                    return self._json({"state": state, "summary": text})
                return self._json({"state": state, "error": text}, 200)

            if u.path == "/email-summary":
                vid = body.get("videoId")
                if not vid:
                    return self._json({"error": "videoId required"}, 400)
                c = open_conn()
                try:
                    state, detail = email_video_summary(
                        c, vid, to=body.get("to"), force=bool(body.get("force")))
                finally:
                    c.close()
                stamp = datetime.now(PERTH).strftime("%H:%M")
                print(f"[{stamp}] email {vid}: {state} {detail}")
                if state in ("sent", "already_sent"):
                    return self._json({"state": state, "detail": detail})
                return self._json({"state": state, "error": detail}, 200)

            if u.path == "/hide":
                vid = body.get("videoId")
                if not vid:
                    return self._json({"error": "videoId required"}, 400)
                now = int(datetime.now(timezone.utc).timestamp() * 1000)
                with lock:
                    c = open_conn()
                    c.execute("UPDATE videos SET hidden = 1, row_updated = ?"
                              " WHERE video_id = ?", (now, vid))
                    c.commit(); c.close()
                return self._json({"hidden": vid})

            if u.path == "/tracked-clear":
                vid = body.get("videoId")
                if not vid:
                    return self._json({"error": "videoId required"}, 400)
                now = int(datetime.now(timezone.utc).timestamp() * 1000)
                undo = bool(body.get("undo"))
                with lock:
                    c = open_conn()
                    c.execute("UPDATE tracked_items SET cleared_at = ?,"
                              " row_updated = ? WHERE video_id = ?",
                              (0 if undo else now, now, vid))
                    c.commit(); c.close()
                return self._json({"cleared": vid, "undo": undo})

            if u.path == "/tracked-add":
                spec = (body.get("channel") or "").strip()
                if not spec and body.get("videoId"):
                    # Fallback for History rows with no channel_url recorded,
                    # which is most of them.
                    try:
                        spec = channel_id_from_video(body["videoId"])
                    except Exception as exc:
                        return self._json({"error": f"could not find the channel"
                                                    f" for that video: {exc}"}, 200)
                if not spec:
                    return self._json({"error": "channel required"}, 400)
                with lock:
                    c = open_conn()
                    try:
                        info = add_tracked_channel(c, spec)
                        refresh_tracked(c, quiet=True, only=info["channelId"])
                    except ValueError as exc:
                        c.close()
                        return self._json({"error": str(exc)}, 200)
                    channels = tracked_channel_rows(c)
                    c.close()
                stamp = datetime.now(PERTH).strftime("%H:%M")
                print(f"[{stamp}] tracked +{info['channelId']}"
                      f" {info['title'] or info['handle']}")
                return self._json({"added": info, "channels": channels})

            if u.path == "/tracked-remove":
                cid = body.get("channelId")
                if not cid:
                    return self._json({"error": "channelId required"}, 400)
                with lock:
                    c = open_conn()
                    c.execute("DELETE FROM tracked_channels WHERE channel_id = ?",
                              (cid,))
                    c.commit()
                    channels = tracked_channel_rows(c)
                    c.close()
                return self._json({"removed": cid, "channels": channels})

            if u.path == "/subs-queue":
                ids = body.get("channelIds") or []
                if not ids:
                    return self._json({"error": "channelIds required"}, 400)
                cancel = bool(body.get("cancel"))
                with lock:
                    c = open_conn()
                    n = queue_unsub(c, ids, cancel=cancel)
                    warnings = [] if cancel else queue_warnings(c, ids)
                    rows = subscription_rows(c)
                    budget = unsub_budget(c)
                    c.close()
                stamp = datetime.now(PERTH).strftime("%H:%M")
                print(f"[{stamp}] unsub {'cancel' if cancel else 'queue'}: {n} channel(s)")
                for w in warnings:
                    print(f"[{stamp}]   note: {w['title']} is {w['why']}")
                return self._json({"changed": n, "subscriptions": rows,
                                   "budget": budget, "warnings": warnings})

            if u.path == "/subs-cancel-all":
                with lock:
                    c = open_conn()
                    n = c.execute(
                        "UPDATE subscriptions SET unsub_state = NULL,"
                        " unsub_queued_at = 0 WHERE unsub_state = 'queued'").rowcount
                    c.commit()
                    rows = subscription_rows(c)
                    budget = unsub_budget(c)
                    c.close()
                stamp = datetime.now(PERTH).strftime("%H:%M")
                print(f"[{stamp}] unsub queue cleared: {n} channel(s)")
                return self._json({"changed": n, "subscriptions": rows,
                                   "budget": budget})

            if u.path == "/subs-sync":
                if not subs_lock.acquire(blocking=False):
                    return self._json({"busy": True})
                try:
                    c = open_conn()
                    try:
                        n = sync_subscriptions(c, quiet=True)
                        rows = subscription_rows(c)
                        budget = unsub_budget(c)
                    finally:
                        c.close()
                except SystemExit as exc:
                    return self._json({"error": str(exc)}, 200)
                finally:
                    subs_lock.release()
                return self._json({"synced": n, "subscriptions": rows,
                                   "budget": budget})

            if u.path == "/tracked-refresh":
                # Outside `lock`: N sequential feed fetches would otherwise
                # stall every ingest and pull from both browsers.
                if not tracked_lock.acquire(blocking=False):
                    return self._json({"checked": 0, "new": 0, "busy": True})
                # Opening the tab sends no force flag, so it costs a fetch only
                # for channels nothing has checked lately; the Refresh button
                # sends force and checks the lot.
                stale = None if body.get("force") else TRACKED_STALE_MINUTES
                try:
                    c = open_conn()
                    try:
                        checked, new = refresh_tracked(c, quiet=True,
                                                       stale_minutes=stale)
                    finally:
                        c.close()
                finally:
                    tracked_lock.release()
                stamp = datetime.now(PERTH).strftime("%H:%M")
                print(f"[{stamp}] tracked refresh: {checked} channels, {new} new")
                return self._json({"checked": checked, "new": new})

            self._json({"error": "not found"}, 404)

        def log_message(self, fmt, *args):
            pass

    try:
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError as exc:
        # Autostart may race with a daemon you already have running; a second
        # copy is pointless rather than harmful, so say so and exit cleanly.
        if exc.errno in (98, 48):   # EADDRINUSE (Linux, BSD)
            print(f"Port {port} is already in use — assuming yth serve is "
                  f"already running. Nothing to do.")
            return
        raise
    print(f"Serving on http://127.0.0.1:{port}  (likes sync every {sync_minutes}m, "
          f"{SERVE_WINDOW_DAYS}-day window)")
    srv.serve_forever()


def cmd_terms(conn, channel, add, remove):
    now = int(datetime.now(timezone.utc).timestamp() * 1000)
    if add:
        if not channel:
            sys.exit("--add needs --channel")
        for pair in add:
            if "=" not in pair:
                sys.exit(f"expected WRONG=RIGHT, got {pair!r}")
            wrong, right = (x.strip() for x in pair.split("=", 1))
            conn.execute(
                "INSERT OR REPLACE INTO channel_terms (channel, wrong, right, added_at)"
                " VALUES (?,?,?,?)", (channel, wrong, right, now))
        conn.commit()
        print(f"Added {len(add)} repair(s) for {channel}.")
    if remove:
        if not channel:
            sys.exit("--remove needs --channel")
        conn.execute("DELETE FROM channel_terms WHERE channel = ? AND wrong = ?",
                     (channel, remove))
        conn.commit()
        print(f"Removed {remove!r} from {channel}.")

    rows = conn.execute(
        "SELECT channel, wrong, right FROM channel_terms"
        + (" WHERE channel = ?" if channel else "")
        + " ORDER BY channel, wrong", (channel,) if channel else ()).fetchall()
    if not rows:
        print("No repairs configured." if not channel else f"No repairs for {channel}.")
        return
    current = None
    for r in rows:
        if r["channel"] != current:
            current = r["channel"]
            print(f"\n{current}:")
        print(f"  {r['wrong']:<20} -> {r['right']}")


def cmd_resync(conn):
    """Re-stamp every row so connected clients pull it again.

    Needed whenever a new field is added: clients track a row_updated cursor, so
    rows they have already consumed are never re-sent, even though the payload
    now carries more than it did when they consumed it.
    """
    # Stagger the stamps. Clients page with "row_updated > cursor", and the
    # cursor is the last row of a page -- so if every row shared one timestamp
    # the cursor could never advance past the first page, and the rest would
    # never be delivered.
    # Unwatched tracked notices are skipped: re-stamping them would permanently
    # convert every Tracked row into History content, which is exactly what the
    # zero stamp at insert time exists to prevent. This is a maintenance command
    # reached for after a schema bump, so the mistake would be silent.
    now = int(datetime.now(timezone.utc).timestamp() * 1000)
    cur = conn.execute(
        "UPDATE videos AS v SET row_updated = ? + rowid WHERE NOT " + UNWATCHED_TRACKED,
        (now,))
    conn.commit()
    print(f"Re-stamped {cur.rowcount} rows. Connected extensions will re-pull "
          f"them on their next sync (2-minute alarm, or open the History tab).")


def cmd_hidden(conn, unhide):
    """List or restore soft-deleted videos.

    Removal is deliberately permanent — it survives both a likes re-sync and a
    re-watch — so there has to be a way back that is not hand-written SQL.
    """
    if unhide:
        cur = conn.execute(
            "UPDATE videos SET hidden = 0, row_updated = ? WHERE video_id = ?",
            (int(datetime.now(timezone.utc).timestamp() * 1000), unhide))
        conn.commit()
        if cur.rowcount:
            print(f"Restored {unhide}. It reappears in the History tab on the next pull.")
        else:
            print(f"No video with id {unhide} in the record.")
        return

    rows = conn.execute(
        "SELECT video_id, title, last_seen FROM videos WHERE hidden = 1"
        " ORDER BY last_seen DESC").fetchall()
    if not rows:
        print("Nothing hidden.")
        return
    print(f"{len(rows)} hidden:")
    for r in rows:
        when = perth_day(r["last_seen"]).strftime("%d %b %H:%M")
        print(f"  {r['video_id']}  {when}  {(r['title'] or '')[:52]}")
    print("\nRestore with:  yth hidden --unhide <video_id>")


