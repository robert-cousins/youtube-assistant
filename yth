VIDEO_ID_RE = re.compile(r"^[a-zA-Z0-9_-]{11}$")


def cmd_export_extension(conn, out_path, force=False):
    """Emit the whole record in the extension's own import format.

    The extension's import is NOT a merge — options.js calls db_replaceDatabase,
    which "clears every application store in one atomic transaction". Feeding it
    a likes-only file would therefore erase the watch history. The only safe
    payload is a superset of what the extension already holds, which is exactly
    what this record is *provided* the latest export has been imported first.
    """
    newest = None
    try:
        newest = newest_export(quiet=True)
    except SystemExit:
        pass

    if not newest and not force:
        # No export to compare against is the DANGEROUS case, not the safe one:
        # the extension replaces its database on import, so emitting a file
        # built from an unverified record would delete whatever the extension
        # holds that this record has never seen.
        sys.exit(
            "Refusing to export: no extension export found to check against, so there "
            "is no way to confirm this record is a superset of what the extension "
            "holds.\n"
            "Importing the result would REPLACE the extension's database and delete "
            "anything missing here.\n\n"
            "Export from the extension's options page first, then:\n"
            "  yth import\n"
            "  yth export-extension\n"
            "(--force overrides, only if you are certain the extension has nothing "
            "worth keeping.)"
        )

    if newest and not force:
        with open(newest) as fh:
            raw = json.load(fh)
        try:
            videos, _, _, _ = parse_export(raw)
        except ExportFormatError:
            videos = []
        known = {r["video_id"] for r in conn.execute("SELECT video_id FROM videos")}
        missing = {video_id_of(v) for v in videos} - known - {None}
        if missing:
            sys.exit(
                f"Refusing to export: {len(missing)} video(s) in {newest} are not in "
                "this record, so importing the result would DELETE them from the "
                "extension.\n"
                f"Run:  yth import {newest}\n"
                "then re-run this command (or pass --force if you are certain)."
            )

    # Unwatched tracked notices are excluded. db_bulkImport clears the stores
    # before writing, so exporting them would replace the extension's History
    # with a list containing videos that were never watched.
    rows = conn.execute(
        "SELECT v.*, l.video_id IS NOT NULL AS liked FROM videos v"
        " LEFT JOIN likes l ON l.video_id = v.video_id"
        " WHERE NOT " + UNWATCHED_TRACKED
    ).fetchall()

    history, skipped = [], 0
    for v in rows:
        vid = v["video_id"]
        if not VIDEO_ID_RE.match(vid or ""):
            # The extension validates ids with this exact pattern and silently
            # drops anything else; better to report it here.
            skipped += 1
            continue
        history.append({
            "videoId": vid,
            "title": (v["title"] or "")[:300],
            "channel": v["channel"] or "",
            "channelUrl": v["channel_url"] or "",
            # The extension rejects time outside 0..86400.
            "time": max(0, min(86400, int(v["last_position"] or 0))),
            "duration": max(0, int(v["duration"] or 0)),
            "watched": bool(v["watched"]),
            "watchCount": max(0, int(v["watch_count"] or 0)),
            **({"live": True} if v["live"] else {}),
            **({"liveReplay": True} if v["live_replay"] else {}),
            "timestamp": max(0, int(v["last_seen"] or 0)),
        })

    valid_ids = {h["videoId"] for h in history}
    sessions = [
        {"videoId": r["video_id"], "watchedAt": int(r["watched_at"]),
         # The extension rejects sessions above 3600 seconds.
         "seconds": max(1, min(3600, int(round(r["seconds"])))),
         "streamType": r["stream_type"] or "normal"}
        for r in conn.execute("SELECT * FROM sessions")
        if r["video_id"] in valid_ids and r["seconds"] and r["seconds"] > 0
    ]
    events = [
        {"videoId": r["video_id"], "watchedAt": int(r["watched_at"]),
         **({"watchDurationSeconds": r["watch_duration_seconds"]}
            if r["watch_duration_seconds"] is not None else {})}
        for r in conn.execute("SELECT * FROM watch_events")
        if r["video_id"] in valid_ids
    ]

    payload = {
        "exportDate": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "dbVersion": 3,
        "count": len(history),
        "history": history,
        "watchEvents": events,
        "watchSessions": sessions,
    }
    Path(out_path).write_text(json.dumps(payload, indent=2))

    liked = sum(1 for r in rows if r["liked"])
    print(f"Wrote {out_path}")
    print(f"  {len(history)} videos ({liked} liked), {len(sessions)} sessions, "
          f"{len(events)} watch events")
    if skipped:
        print(f"  {skipped} skipped — id not in YouTube's 11-character format")
    print("\nImport it via the extension's options page. Note the extension REPLACES")
    print("its database on import; this file is a superset, so nothing is lost.")



