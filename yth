#!/usr/bin/env python3
"""yth — progressive YouTube watch-history record.

Consumes exports from the yt-watch-history browser extension and merges them
into a durable SQLite record, then renders a windowed report.

  yth import [FILE]        merge an export (defaults to newest in ~/Downloads)
  yth report [--since 5d]  render markdown (or --json)
  yth track add @handle    watch a channel for new uploads (Tracked tab)

Every export is a full snapshot, so import is a merge, not an incremental
fetch: skip a week and the next import backfills it.
"""

