class ExportFormatError(Exception):
    """The export did not match the expected shape."""


def connect(path):
    global _QUOTA_DB
    _QUOTA_DB = str(path)
    conn = sqlite3.connect(path, timeout=30)
    conn.execute("PRAGMA busy_timeout = 30000")
    conn.row_factory = sqlite3.Row
    conn.executescript(SCHEMA)
    # Databases created before the likes feature lack the source column.
    cols = {r["name"] for r in conn.execute("PRAGMA table_info(videos)")}
    if "source" not in cols:
        conn.execute("ALTER TABLE videos ADD COLUMN source TEXT DEFAULT 'extension'")
        conn.commit()
    if "row_updated" not in cols:
        # Monotonic per-row stamp so each client can ask "what changed since X".
        conn.execute("ALTER TABLE videos ADD COLUMN row_updated INTEGER DEFAULT 0")
        conn.execute("UPDATE videos SET row_updated = COALESCE(last_seen, 0)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_videos_row_updated"
                     " ON videos(row_updated)")
        conn.commit()
    if "description" not in cols:
        # Descriptions come only from the API — neither the extension nor the
        # export carries them — so they are backfilled rather than captured.
        conn.execute("ALTER TABLE videos ADD COLUMN description TEXT")
        conn.commit()
    if "summary" not in cols:
        # Kept separate from `description` so the YouTube text survives and a
        # re-summarise is never destructive.
        conn.execute("ALTER TABLE videos ADD COLUMN summary TEXT")
        # 'ok' | 'no_transcript' | 'error'. NULL means never attempted, which is
        # what lets the UI distinguish "not tried" from "tried, impossible".
        conn.execute("ALTER TABLE videos ADD COLUMN summary_state TEXT")
        conn.execute("ALTER TABLE videos ADD COLUMN summary_at INTEGER")
        conn.commit()
    if "published_at" not in cols:
        # The article byline asks for a publication date, which the model cannot
        # know unless we hand it over.
        conn.execute("ALTER TABLE videos ADD COLUMN published_at TEXT")
        conn.commit()
    if "transcript" not in cols:
        # Cached at generation time: re-fetching for verification doubles the
        # load on YouTube's unofficial endpoint and gets rate-limited, and a
        # failed fetch used to degrade verification silently.
        conn.execute("ALTER TABLE videos ADD COLUMN transcript TEXT")
        conn.commit()
    if "article" not in cols:
        # Kept apart from `summary`: the article is written for an email reader
        # and is far too long for the History column.
        conn.execute("ALTER TABLE videos ADD COLUMN article TEXT")
        conn.execute("ALTER TABLE videos ADD COLUMN article_at INTEGER")
        conn.execute("ALTER TABLE videos ADD COLUMN article_cost REAL")
        conn.execute("ALTER TABLE videos ADD COLUMN article_ms INTEGER")
        conn.commit()
    if "emailed_at" not in cols:
        # Recorded server-side so "already sent" survives a browser reload and
        # is the same answer in both profiles.
        conn.execute("ALTER TABLE videos ADD COLUMN emailed_at INTEGER")
        conn.execute("ALTER TABLE videos ADD COLUMN emailed_to TEXT")
        conn.commit()
    if "summary_cost" not in cols:
        # Actual billed cost from OpenRouter, plus wall-clock for the whole
        # click-to-result path, so the footer reports what was really spent.
        conn.execute("ALTER TABLE videos ADD COLUMN summary_cost REAL")
        conn.execute("ALTER TABLE videos ADD COLUMN summary_ms INTEGER")
        conn.execute("ALTER TABLE videos ADD COLUMN summary_tokens_in INTEGER")
        conn.execute("ALTER TABLE videos ADD COLUMN summary_tokens_out INTEGER")
        conn.commit()
    if "hidden" not in cols:
        # Soft delete: a hard delete would be undone by the next likes sync,
        # since the video is still in the likes playlist.
        conn.execute("ALTER TABLE videos ADD COLUMN hidden INTEGER DEFAULT 0")
        conn.commit()
    if "channel_id" not in cols:
        # Matching subscriptions to watch history by display name is fuzzy and
        # breaks when a channel renames. videos.list already returns
        # snippet.channelId on the call the backfill makes anyway, so the exact
        # key costs nothing extra.
        conn.execute("ALTER TABLE videos ADD COLUMN channel_id TEXT")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_videos_channel_id"
                     " ON videos(channel_id)")
        conn.commit()
    tc_cols = {r["name"] for r in conn.execute("PRAGMA table_info(tracked_channels)")}
    if tc_cols and "fail_count" not in tc_cols:
        conn.execute("ALTER TABLE tracked_channels ADD COLUMN last_ok INTEGER")
        conn.execute("ALTER TABLE tracked_channels ADD COLUMN fail_count INTEGER DEFAULT 0")
        conn.commit()
    like_cols = {r["name"] for r in conn.execute("PRAGMA table_info(likes)")}
    if like_cols and "approximate" not in like_cols:
        conn.execute("ALTER TABLE likes ADD COLUMN approximate INTEGER DEFAULT 0")
        conn.commit()
    return conn


# ---------------------------------------------------------------- parsing

def parse_export(raw):
    """Pull (videos, sessions, export_date) out of an extension export.

    Fails loudly on an unrecognised shape. A silent default here would turn a
    renamed key into a cheerful empty report, which is the worst outcome for a
    record you are trusting to be complete.
    """
    if isinstance(raw, list):
        # The extension's own importer accepts a bare array of videos.
        return raw, [], [], None

    if not isinstance(raw, dict):
        raise ExportFormatError(
            f"expected a JSON object or array at the top level, got {type(raw).__name__}"
        )

    # Videos live under 'history' in real exports; 'videos' is the internal
    # store name and is accepted defensively.
    for key in ("history", "videos"):
        if isinstance(raw.get(key), list):
            videos = raw[key]
            break
    else:
        raise ExportFormatError(
            "no video list found — expected a 'history' (or 'videos') array. "
            f"Top-level keys present: {sorted(raw)}. "
            "The export format may have changed; refusing to import rather "
            "than write an empty record."
        )

    sessions = raw.get("watchSessions") or []
    if not isinstance(sessions, list):
        raise ExportFormatError("'watchSessions' present but not an array")

    events = raw.get("watchEvents") or []
    if not isinstance(events, list):
        raise ExportFormatError("'watchEvents' present but not an array")

    return videos, sessions, events, raw.get("exportDate")


def video_id_of(v):
    """Accept both the current 'videoId' and the legacy 'id' field."""
    for key in ("videoId", "id"):
        val = v.get(key)
        if isinstance(val, str) and val:
            return val
    return None


def clean_channel(raw):
    """Mirror of the extension's cleanChannelName.

    YouTube's ytd-channel-name can yield the name twice as separate text nodes.
    Only that exact shape is collapsed, so a channel really called "Duran Duran"
    (single space) survives.
    """
    if not raw:
        return ""
    parts = [p.strip() for p in re.split(r"\n|\s{2,}", str(raw)) if p.strip()]
    if len(parts) == 2 and parts[0] == parts[1]:
        return parts[0]
    return re.sub(r"\s+", " ", str(raw)).strip()


def as_int(value, default=0):
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


# ---------------------------------------------------------------- import

def do_import(conn, path):
    with open(path) as fh:
        raw = json.load(fh)

    videos, sessions, events, export_date = parse_export(raw)
    cur = conn.cursor()
    new_videos = 0

    for v in videos:
        vid = video_id_of(v)
        if not vid:
            continue
        ts = as_int(v.get("timestamp"))
        row = cur.execute("SELECT * FROM videos WHERE video_id = ?", (vid,)).fetchone()

        incoming = {
            "title": (v.get("title") or "").strip(),
            "channel": clean_channel(v.get("channel")),
            "channel_url": v.get("channelUrl") or "",
            "duration": as_int(v.get("duration")),
            "watched": 1 if v.get("watched") else 0,
            "live": 1 if v.get("live") else 0,
            "live_replay": 1 if v.get("liveReplay") else 0,
        }
        position = as_int(v.get("time"))
        count = as_int(v.get("watchCount"))

        if row is None:
            new_videos += 1
            first_seen, last_seen = ts, ts
            merged = incoming
        else:
            first_seen = min(row["first_seen"] or ts, ts) if ts else row["first_seen"]
            last_seen = max(row["last_seen"] or ts, ts)

            # Two profiles (or an archived export imported after a newer one)
            # arrive in arbitrary order, so the merge cannot be last-writer-wins.
            # Monotonic facts take the max; descriptive fields follow whichever
            # side is actually fresher. The comparison uses the raw incoming ts
            # against the *stored* last_seen — after last_seen is max-merged the
            # test would always pass.
            position = max(position, row["last_position"] or 0)
            count = max(count, row["watch_count"] or 0)
            fresher = ts >= (row["last_seen"] or 0)
            merged = incoming if fresher else {
                k: row[k] for k in incoming
            }

        cur.execute(
            """INSERT INTO videos (video_id, title, channel, channel_url, duration,
                                   last_position, watched, watch_count, live,
                                   live_replay, first_seen, last_seen)
               VALUES (?,?,?,?,?,?,?,?,?,?,?,?)
               ON CONFLICT(video_id) DO UPDATE SET
                   title=excluded.title, channel=excluded.channel,
                   channel_url=excluded.channel_url, duration=excluded.duration,
                   last_position=excluded.last_position, watched=excluded.watched,
                   watch_count=excluded.watch_count, live=excluded.live,
                   live_replay=excluded.live_replay,
                   first_seen=excluded.first_seen, last_seen=excluded.last_seen""",
            (
                vid, merged["title"], merged["channel"], merged["channel_url"],
                merged["duration"], position, merged["watched"], count,
                merged["live"], merged["live_replay"], first_seen, last_seen,
            ),
        )

    before = conn.total_changes
    for s in sessions:
        vid = s.get("videoId")
        watched_at = as_int(s.get("watchedAt"))
        if not vid or not watched_at:
            continue
        try:
            seconds = float(s.get("seconds") or 0)
        except (TypeError, ValueError):
            continue
        if seconds <= 0:
            continue
        cur.execute(
            "INSERT OR IGNORE INTO sessions VALUES (?,?,?,?)",
            (vid, watched_at, seconds, s.get("streamType") or "normal"),
        )
    new_sessions = conn.total_changes - before

    before_events = conn.total_changes
    for e in events:
        vid = e.get("videoId")
        watched_at = as_int(e.get("watchedAt"))
        if not vid or not watched_at:
            continue
        dur = e.get("watchDurationSeconds")
        cur.execute("INSERT OR IGNORE INTO watch_events VALUES (?,?,?)",
                    (vid, watched_at,
                     float(dur) if isinstance(dur, (int, float)) else None))
    new_events = conn.total_changes - before_events

    # The extension keeps only one mutable timestamp per video, so on a first
    # import 'first_seen' is really "when last saved" and older viewing
    # collapses onto import day. Session rows are append-only and do remember
    # the earlier watches, so pull first_seen back to the earliest evidence.
    cur.execute(
        """UPDATE videos SET first_seen = (
               SELECT MIN(s.watched_at) FROM sessions s
               WHERE s.video_id = videos.video_id
           )
           WHERE EXISTS (
               SELECT 1 FROM sessions s
               WHERE s.video_id = videos.video_id
                 AND s.watched_at < videos.first_seen
           )"""
    )

    cur.execute(
        "INSERT INTO imports (imported_at, source_file, export_date, new_videos, new_sessions)"
        " VALUES (?,?,?,?,?)",
        (
            int(datetime.now(timezone.utc).timestamp() * 1000),
            str(path),
            export_date,
            new_videos,
            new_sessions,
        ),
    )
    conn.commit()
    return new_videos, new_sessions, new_events, len(videos), len(sessions), len(events)



# ---------------------------------------------------------------- youtube api

ISO_DURATION = re.compile(
    r"^P(?:(?P<days>\d+)D)?"
    r"(?:T(?:(?P<hours>\d+)H)?(?:(?P<minutes>\d+)M)?(?:(?P<seconds>[\d.]+)S)?)?$"
)


def parse_iso_duration(text):
    """ISO 8601 duration -> seconds. 'P0D' (live/upcoming) becomes 0.

    Python has no stdlib parser for these, and YouTube emits a day component
    for long videos (P1DT2H3M4S), so the regex has to cover it.
    """
    if not text:
        return 0
    m = ISO_DURATION.match(text)
    if not m:
        return 0
    d = m.groupdict()
    return int(
        int(d["days"] or 0) * 86400
        + int(d["hours"] or 0) * 3600
        + int(d["minutes"] or 0) * 60
        + float(d["seconds"] or 0)
    )


def read_creds(path=None):
    path = path or CREDS_PATH
    if not path.exists():
        which = {GMAIL_CREDS_PATH: "--gmail ", WRITE_CREDS_PATH: "--write "}.get(path, "")
        sys.exit(f"Not authorised yet. Run:  yth auth {which}--from-env")
    return json.loads(path.read_text())


def write_creds(data, path=None):
    path = path or CREDS_PATH
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2))
    path.chmod(0o600)


def post_form(url, fields):
    body = urllib.parse.urlencode(fields).encode()
    req = urllib.request.Request(url, data=body,
                                 headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as exc:
        sys.exit(f"OAuth request failed ({exc.code}): {exc.read().decode()[:400]}")


def access_token(path=None):
    """Exchange the stored refresh token for a short-lived access token."""
    creds = read_creds(path)
    data = post_form(TOKEN_URL, {
        "client_id": creds["client_id"],
        "client_secret": creds["client_secret"],
        "refresh_token": creds["refresh_token"],
        "grant_type": "refresh_token",
    })
    if "access_token" not in data:
        sys.exit("Refresh failed — re-run `yth auth`. An OAuth client left in "
                 "'Testing' publishing status expires refresh tokens after ~7 days.")
    return data["access_token"]


# Set by connect(). The quota ledger has to be writable from api_get, which is
# called from a dozen places that have no connection to hand; a path is the
# smallest thing that threads through.
_QUOTA_DB = None


def pacific_day(when=None):
    """Today's date in the timezone YouTube resets the quota in.

    Midnight America/Los_Angeles, which observes DST — so a fixed offset is
    wrong for half the year. zoneinfo is used when the system carries tzdata,
    with the US rule (second Sunday in March to first Sunday in November) as a
    fallback so this never hard-fails on a minimal container.
    """
    when = when or datetime.now(timezone.utc)
    try:
        from zoneinfo import ZoneInfo
        return when.astimezone(ZoneInfo("America/Los_Angeles")).date().isoformat()
    except Exception:
        y = when.year

        def nth_sunday(month, nth):
            d = datetime(y, month, 1, tzinfo=timezone.utc)
            d += timedelta(days=(6 - d.weekday()) % 7 + 7 * (nth - 1))
            return d

        dst = nth_sunday(3, 2) <= when < nth_sunday(11, 1)
        return (when + timedelta(hours=-7 if dst else -8)).date().isoformat()


def record_quota(units, endpoint=""):
    """Debit the ledger. Called BEFORE the request for write operations.

    Ordering is deliberate on the destructive path: a crash between issuing a
    delete and committing its cost would lose the debit, and the next daemon
    start would happily re-spend it.
    """
    if not _QUOTA_DB or not units:
        return
    try:
        c = sqlite3.connect(_QUOTA_DB, timeout=30)
        c.execute("PRAGMA busy_timeout = 30000")
        c.execute(
            "INSERT INTO quota_usage (day, units, calls, updated) VALUES (?, ?, 1, ?)"
            " ON CONFLICT(day) DO UPDATE SET units = units + excluded.units,"
            "   calls = calls + 1, updated = excluded.updated",
            (pacific_day(), units,
             int(datetime.now(timezone.utc).timestamp() * 1000)))
        c.commit(); c.close()
    except Exception:
        # Metering must never take down a working API call.
        pass


def quota_spent(conn, day=None):
    row = conn.execute("SELECT units, calls FROM quota_usage WHERE day = ?",
                       (day or pacific_day(),)).fetchone()
    return (row["units"] or 0, row["calls"] or 0) if row else (0, 0)


def api_get(endpoint, params, token, cost=1):
    url = f"{API_ROOT}/{endpoint}?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    record_quota(cost, endpoint)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as exc:
        sys.exit(f"YouTube API error ({exc.code}) on {endpoint}: {exc.read().decode()[:400]}")


def api_delete(endpoint, params, token):
    """DELETE against the Data API. Quota is debited by the caller.

    Separate from api_get and used from exactly one place. The cost is not
    metered here because the write path records it *before* issuing the request
    -- see drain_unsub_queue -- and metering in both would double-count.
    """
    url = f"{API_ROOT}/{endpoint}?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, method="DELETE",
                                 headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            r.read()
            return True
    except urllib.error.HTTPError as exc:
        raise RuntimeError(
            f"{exc.code}: {exc.read().decode()[:200]}") from None


def cmd_auth(client_secret_file, from_env=False, port=0,
             scope=SCOPE, creds_path=None):
    """OAuth2 loopback flow with PKCE.

    Google withdrew the out-of-band copy-paste flow, so a local redirect is the
    only option for an installed app. Verified that Windows Chrome can reach a
    server bound inside WSL on 127.0.0.1.
    """
    if from_env:
        # The _YTH pair is this tool's own dedicated client; the unsuffixed pair
        # belongs to another app and is only a fallback.
        client_id = (os.environ.get("GOOGLE_OAUTH_CLIENT_ID_YTH")
                     or os.environ.get("GOOGLE_OAUTH_CLIENT_ID", ""))
        client_secret = (os.environ.get("GOOGLE_OAUTH_CLIENT_SECRET_YTH")
                         or os.environ.get("GOOGLE_OAUTH_CLIENT_SECRET", ""))
        if not client_id or not client_secret:
            sys.exit("Set GOOGLE_OAUTH_CLIENT_ID_YTH / GOOGLE_OAUTH_CLIENT_SECRET_YTH "
                     "(or the unsuffixed pair) in ~/.bash_secrets, "
                     "or pass --client-secret <file.json>.")
        print(f"Using client {client_id[:20]}… "
              f"({'_YTH' if os.environ.get('GOOGLE_OAUTH_CLIENT_ID_YTH') else 'fallback'})")
    else:
        raw = json.loads(Path(client_secret_file).read_text())
        block = raw.get("installed") or raw.get("web")
        if not block:
            sys.exit("That file has neither an 'installed' nor a 'web' section — "
                     "download an OAuth client ID of type 'Desktop app'.")
        client_id, client_secret = block["client_id"], block["client_secret"]

    verifier = base64.urlsafe_b64encode(secrets.token_bytes(64)).decode().rstrip("=")
    challenge = base64.urlsafe_b64encode(
        hashlib.sha256(verifier.encode()).digest()).decode().rstrip("=")
    state = secrets.token_urlsafe(16)

    holder = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            holder.update({k: v[0] for k, v in q.items()})
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            ok = "code" in q and q.get("state", [None])[0] == state
            self.wfile.write(
                b"<h2>Authorised. You can close this tab.</h2>" if ok
                else b"<h2>Authorisation failed. Check the terminal.</h2>")

        def log_message(self, *a):
            pass

    # Port 0 picks a free port, which is fine for a Desktop-app client: those
    # accept any loopback port. A Web-application client rejects anything not
    # registered exactly, so --port lets you pin it to a URI you registered.
    server = http.server.HTTPServer(("127.0.0.1", port), Handler)
    port = server.server_address[1]
    redirect_uri = f"http://127.0.0.1:{port}"
    threading.Thread(target=server.handle_request, daemon=True).start()

    url = AUTH_URL + "?" + urllib.parse.urlencode({
        "client_id": client_id, "redirect_uri": redirect_uri,
        "response_type": "code", "scope": scope,
        # select_account forces the chooser: without it Google silently reuses
        # the last account, which is how you end up authorising one with no
        # YouTube channel and getting an empty sync.
        "access_type": "offline", "prompt": "select_account consent",
        "code_challenge": challenge, "code_challenge_method": "S256",
        "state": state,
    })
    print("Open this URL in your browser and approve access:\n")
    print(url + "\n")
    print(f"Waiting for the redirect on {redirect_uri} ...")

    server.socket.settimeout(300)
    for _ in range(300):
        if "code" in holder or "error" in holder:
            break
        __import__("time").sleep(1)

    if "code" not in holder:
        sys.exit(f"No authorisation code received ({holder.get('error', 'timed out')}).")
    if holder.get("state") != state:
        sys.exit("State mismatch — aborting rather than trusting the redirect.")

    tok = post_form(TOKEN_URL, {
        "client_id": client_id, "client_secret": client_secret,
        "code": holder["code"], "code_verifier": verifier,
        "grant_type": "authorization_code", "redirect_uri": redirect_uri,
    })
    if "refresh_token" not in tok:
        sys.exit("Google returned no refresh token. Revoke this app's access at "
                 "https://myaccount.google.com/permissions and run `yth auth` again.")

    target = creds_path or CREDS_PATH
    write_creds({"client_id": client_id, "client_secret": client_secret,
                 "refresh_token": tok["refresh_token"], "scope": scope}, target)
    print(f"Authorised. Refresh token stored at {target} (mode 0600).")


def fetch_likes(token, verbose=False):
    """Every item in the account's 'liked videos' playlist.

    playlistItems.snippet.publishedAt is when the item was ADDED to the
    playlist — i.e. when it was liked — which is the timestamp the report needs.
    The video's own upload date is contentDetails.videoPublishedAt, not this.
    """
    ch = api_get("channels", {"part": "contentDetails", "mine": "true"}, token)
    items = ch.get("items") or []
    if not items:
        sys.exit("No channel found for this account.")
    playlist = items[0]["contentDetails"]["relatedPlaylists"].get("likes")
    if not playlist:
        sys.exit("This account exposes no likes playlist.")

    liked, page = [], None
    while True:
        params = {"part": "snippet", "playlistId": playlist, "maxResults": 50}
        if page:
            params["pageToken"] = page
        data = api_get("playlistItems", params, token)
        batch = data.get("items") or []
        if verbose and not liked and batch:
            # playlistItems.list takes no order parameter, so reverse-chronological
            # is undocumented behaviour. Report it rather than depend on it.
            print(f"  page 1 spans {batch[0]['snippet']['publishedAt']} "
                  f"-> {batch[-1]['snippet']['publishedAt']}")
        liked.extend(batch)
        page = data.get("nextPageToken")
        if not page:
            break
    return liked


def fetch_durations(video_ids, token):
    """{video_id: seconds}. Keyed by id, never zipped by position.

    videos.list silently omits deleted, private and region-blocked videos, which
    the likes playlist still returns as items — pairing by index would attach one
    video's duration to another's title.
    """
    out = {}
    for i in range(0, len(video_ids), 50):
        chunk = video_ids[i:i + 50]
        data = api_get("videos", {"part": "contentDetails", "id": ",".join(chunk)}, token)
        for item in data.get("items") or []:
            out[item["id"]] = parse_iso_duration(item["contentDetails"].get("duration"))
    return out


def fetch_snippets(video_ids, token):
    """{video_id: (description, title, channel, published, duration)}, 50/call.

    contentDetails rides along on the same request: it costs no extra quota
    unit and saves a second pass for videos discovered from a channel feed,
    which carries everything except the duration.
    """
    out = {}
    for i in range(0, len(video_ids), 50):
        chunk = video_ids[i:i + 50]
        data = api_get("videos", {"part": "snippet,contentDetails",
                                  "id": ",".join(chunk)}, token)
        for item in data.get("items") or []:
            sn = item.get("snippet") or {}
            cd = item.get("contentDetails") or {}
            out[item["id"]] = (sn.get("description") or "",
                               (sn.get("title") or "").strip(),
                               (sn.get("channelTitle") or "").strip(),
                               sn.get("publishedAt") or "",
                               parse_iso_duration(cd.get("duration")))
    return out


# A tracked discovery nobody has opened. Every surface that reads `videos`
# broadly has to exclude these, and each surface keys on a different column, so
# the predicate lives here once rather than being retyped (and mistyped) in
# gather(), cmd_resync(), cmd_export_extension() and the backfill.
UNWATCHED_TRACKED = (
    "(v.source = 'tracked' AND COALESCE(v.watch_count, 0) = 0"
    " AND COALESCE(v.last_position, 0) = 0"
    " AND NOT EXISTS (SELECT 1 FROM sessions s WHERE s.video_id = v.video_id))"
)


def backfill_descriptions(conn, limit=200, quiet=False):
    """Fill in descriptions, publication dates and durations that are missing.

    Deleted and private videos never come back from videos.list, so they would
    be retried forever. They are marked with an empty string rather than left
    NULL, which is what distinguishes 'no description' from 'not fetched yet'.
    """
    # Any of the three missing is reason to fetch. published_at was introduced
    # long after descriptions were filled, and keying only on description meant
    # those rows were never revisited, leaving 1297/1298 without a date; the
    # same trap then applied to duration, which channel feeds never supply.
    #
    # The duration clause excludes description = '', the marker this function
    # writes for a video the API would not return. Without that, the 21
    # deleted/private liked videos would be re-queried on every single pass.
    pending = [r["video_id"] for r in conn.execute(
        "SELECT video_id FROM videos"
        " WHERE description IS NULL OR published_at IS NULL"
        "    OR (COALESCE(duration, 0) = 0 AND COALESCE(description, '') != '')"
        " ORDER BY last_seen DESC LIMIT ?", (limit,))]
    if not pending:
        # A tuple, not 0. Every caller unpacks two values, so the bare int made
        # the daemon's likes loop raise "cannot unpack non-iterable int object"
        # on every cycle -- but only once the backfill had nothing left to do,
        # which is why it lay dormant until the day descriptions completed.
        return 0, 0

    token = access_token()
    snippets = fetch_snippets(pending, token)
    now = int(datetime.now(timezone.utc).timestamp() * 1000)
    filled = timed = 0
    for vid in pending:
        desc, title, channel, published, seconds = snippets.get(
            vid, ("", "", "", "", 0))
        # Unavailable videos get "" so they are not re-queried on every pass.
        # row_updated is conditional. Filling a duration must not push an
        # unwatched tracked notice into History's /recent feed -- that is the
        # same leak `row_updated = 0` closes at insert time, and an
        # unconditional stamp here reopened it for all 39 of them.
        conn.execute(
            "UPDATE videos AS v SET description = COALESCE(description, ?),"
            "  row_updated = CASE WHEN " + UNWATCHED_TRACKED
            + " THEN row_updated ELSE ? END,"
            "  channel = CASE WHEN COALESCE(channel,'') = '' THEN ? ELSE channel END,"
            "  published_at = COALESCE(published_at, ?),"
            "  duration = CASE WHEN COALESCE(duration, 0) = 0 THEN ? ELSE duration END"
            " WHERE video_id = ?",
            (desc, now, clean_channel(channel), published or "", seconds, vid))
        if desc:
            filled += 1
        if seconds:
            timed += 1
    conn.commit()
    if not quiet:
        print(f"  descriptions: {len(pending)} checked, {filled} with text, "
              f"{len(pending) - filled} unavailable/empty; {timed} durations")
    return len(pending), filled


def cmd_sync_likes(conn, verbose=False, quiet=False):
    """quiet=True suppresses the no-change chatter: the daemon runs this every
    few minutes and would otherwise fill its log with identical blocks."""
    def say(msg):
        if not quiet:
            print(msg)

    token = access_token()
    say("Fetching liked videos...")
    items = fetch_likes(token, verbose=verbose)
    say(f"  {len(items)} items in the likes playlist")

    # playlistItems.snippet.publishedAt is when the item was added to the
    # playlist, so normally this is a real like time. When it is missing or
    # unparseable the item is still worth having: stamp it with the sync time
    # and flag it, rather than dropping it and under-reporting silently.
    now_ms = int(datetime.now(timezone.utc).timestamp() * 1000)
    rows, assumed = [], 0
    for it in items:
        sn = it.get("snippet") or {}
        vid = (sn.get("resourceId") or {}).get("videoId")
        if not vid:
            continue
        liked_at = iso_to_ms(sn.get("publishedAt"))
        approximate = 0
        if not liked_at:
            liked_at, approximate = now_ms, 1
            assumed += 1
        rows.append((vid, liked_at, (sn.get("title") or "").strip(),
                     (sn.get("videoOwnerChannelTitle") or "").strip(), approximate))

    # Only ask for durations we do not already hold. This used to fetch all
    # 1,238 liked videos on every run -- 25 quota units every 10 minutes, about
    # 7,200 units a day against a 10,000 allocation, for values that had not
    # changed since the first sync. It was invisible until the quota ledger
    # existed, and it was quietly consuming most of the day's budget.
    have = {r["video_id"] for r in conn.execute(
        "SELECT video_id FROM videos WHERE COALESCE(duration, 0) > 0")}
    wanted = [r[0] for r in rows if r[0] not in have]
    durations = fetch_durations(wanted, token) if wanted else {}
    unavailable = sum(1 for vid in wanted if vid not in durations)

    cur = conn.cursor()
    before = conn.total_changes
    new_videos = 0
    for vid, liked_at, title, channel, approximate in rows:
        # A real timestamp seen on a later sync supersedes an assumed one; an
        # assumed one never overwrites a real one.
        prior = cur.execute(
            "SELECT liked_at, approximate FROM likes WHERE video_id = ?", (vid,)).fetchone()
        if prior is not None and approximate and not prior["approximate"]:
            liked_at, approximate = prior["liked_at"], 0
        superseded = (prior is not None and prior["approximate"] and not approximate)
        cur.execute("INSERT OR REPLACE INTO likes VALUES (?,?,?)",
                    (vid, liked_at, approximate))

        if superseded:
            # A real date replacing an assumed one is usually EARLIER, and
            # last_seen is max-merged so it cannot move backwards on its own.
            # For a video known only from the like, the like time is the whole
            # truth, so reset both ends outright — otherwise the row would stay
            # filed under the day we happened to sync.
            cur.execute(
                """UPDATE videos SET first_seen = ?, last_seen = ?
                   WHERE video_id = ? AND source = 'youtube_api'
                     AND NOT EXISTS (SELECT 1 FROM sessions s WHERE s.video_id = ?)""",
                (liked_at, liked_at, vid, vid))
        existing = cur.execute(
            "SELECT duration, last_seen, first_seen FROM videos WHERE video_id = ?",
            (vid,)).fetchone()
        if existing is None:
            # Known only from the API: no sessions will ever exist for it, so the
            # report must not describe it as "not played".
            new_videos += 1
            cur.execute(
                """INSERT INTO videos (video_id, title, channel, channel_url, duration,
                                       last_position, watched, watch_count, live,
                                       live_replay, first_seen, last_seen, source)
                   VALUES (?,?,?,?,?,0,0,0,0,0,?,?,'youtube_api')""",
                (vid, title, channel, "", durations.get(vid, 0), liked_at, liked_at))
        else:
            # The extension's record is richer; only fill genuine gaps and move
            # last_seen forward so a phone-only like lands in the right window.
            cur.execute(
                """UPDATE videos SET
                       duration = CASE WHEN COALESCE(duration,0) = 0 THEN ? ELSE duration END,
                       title    = CASE WHEN COALESCE(title,'')  = '' THEN ? ELSE title END,
                       channel  = CASE WHEN COALESCE(channel,'')= '' THEN ? ELSE channel END,
                       last_seen  = MAX(COALESCE(last_seen,0), ?),
                       first_seen = MIN(COALESCE(first_seen, ?), ?)
                   WHERE video_id = ?""",
                (durations.get(vid, 0), title, channel, liked_at, liked_at, liked_at, vid))
    conn.commit()

    say(f"  +{new_videos} videos new to the record")
    say(f"  {conn.total_changes - before} rows touched")
    if unavailable:
        say(f"  {unavailable} liked videos are deleted/private — kept, duration unknown")
    if assumed:
        say(f"  {assumed} had no like date — stamped with the sync time and "
            f"flagged approximate")
    return new_videos


def iso_to_ms(text):
    if not text:
        return 0
    try:
        return int(datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp() * 1000)
    except ValueError:
        return 0


# ---------------------------------------------------------------- report

def parse_since(text):
    m = re.fullmatch(r"(\d+)\s*([dhw])", text.strip().lower())
    if not m:
        raise argparse.ArgumentTypeError("--since expects forms like 5d, 36h, 2w")
    n, unit = int(m.group(1)), m.group(2)
    return {"d": n, "w": n * 7, "h": n}, unit


def window_start_ms(since):
    """Start of the window, in epoch ms.

    Day and week windows snap to the start of a Perth calendar day so that day
    headers are never half-populated; hour windows stay rolling.
    """
    counts, unit = since
    now = datetime.now(PERTH)
    if unit == "h":
        start = now - timedelta(hours=counts["h"])
    else:
        days = counts["d"] if unit == "d" else counts["w"]
        midnight = now.replace(hour=0, minute=0, second=0, microsecond=0)
        start = midnight - timedelta(days=days - 1)
    return int(start.timestamp() * 1000)


def perth_day(ms):
    return datetime.fromtimestamp(ms / 1000, PERTH)


def fmt_duration(seconds):
    seconds = int(round(seconds or 0))
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}h {m:02d}m"
    if m:
        return f"{m}m"
    return f"{s}s"


def gather(conn, start_ms):
    """Videos whose last sighting falls in the window, plus their sessions.

    Sessions are attached in full so --json can carry lifetime totals, but every
    figure the markdown report prints is window-scoped: otherwise a video
    re-opened today after an hour of viewing last month would render "1h · 80%"
    under today's date while contributing nothing to the header, and the rows
    would not sum to the summary line.
    """
    # Tracked-tab discoveries carry last_seen = publication time, so without the
    # NOT EXISTS clause a channel you merely follow would fill this report with
    # "not played" rows it never watched. The same leak was closed on the
    # History tab via row_updated = 0; the report reads last_seen instead, so it
    # needs its own guard. A tracked video you actually open gains a session (or
    # a watch_count) and reappears here legitimately.
    videos = conn.execute(
        "SELECT v.*, l.liked_at, l.approximate AS liked_approx FROM videos v"
        " LEFT JOIN likes l ON l.video_id = v.video_id"
        " WHERE v.last_seen >= ? AND NOT " + UNWATCHED_TRACKED
        + " ORDER BY v.last_seen DESC", (start_ms,)
    ).fetchall()

    rows = []
    seen_ids = set()
    for v in videos:
        seen_ids.add(v["video_id"])
        sessions = conn.execute(
            "SELECT watched_at, seconds, stream_type FROM sessions"
            " WHERE video_id = ? ORDER BY watched_at",
            (v["video_id"],),
        ).fetchall()
        rows.append(build_row(dict(v), sessions, start_ms))

    # Orphan sessions: watch time recorded for a video that has no metadata
    # row. Real, and reachable by link, so surfaced rather than dropped.
    orphans = conn.execute(
        "SELECT video_id, watched_at, seconds, stream_type FROM sessions"
        " WHERE watched_at >= ? AND video_id NOT IN (SELECT video_id FROM videos)"
        " ORDER BY watched_at",
        (start_ms,),
    ).fetchall()
    by_vid = {}
    for s in orphans:
        by_vid.setdefault(s["video_id"], []).append(s)
    for vid, sess in by_vid.items():
        stub = {
            "video_id": vid, "title": "", "channel": "", "channel_url": "",
            "duration": 0, "last_position": 0, "watched": 0, "watch_count": 0,
            "live": 0, "live_replay": 0, "liked_at": None, "liked_approx": None,
            "source": "extension",
            "first_seen": sess[0]["watched_at"], "last_seen": sess[-1]["watched_at"],
        }
        row = build_row(stub, sess, start_ms)
        row["orphan"] = True
        rows.append(row)

    rows.sort(key=lambda r: r["last_seen"], reverse=True)
    return rows


def build_row(v, sessions, start_ms):
    total = sum(s["seconds"] for s in sessions)
    in_window = sum(s["seconds"] for s in sessions if s["watched_at"] >= start_ms)
    days = {perth_day(s["watched_at"]).date().isoformat() for s in sessions}
    window_days = {perth_day(s["watched_at"]).date().isoformat()
                   for s in sessions if s["watched_at"] >= start_ms}
    duration = v["duration"] or 0
    is_live = bool(v["live"] or v["live_replay"])

    # Live streams store duration as 0, so a percentage would be meaningless.
    def pct_of(seconds):
        if duration <= 0 or is_live:
            return None
        return round(min(seconds / duration, 1.0) * 100)

    liked_at = v["liked_at"] if "liked_at" in v.keys() else None
    return {
        "video_id": v["video_id"],
        "liked": liked_at is not None,
        "liked_at": liked_at,
        "liked_at_perth": perth_day(liked_at).isoformat() if liked_at else None,
        "liked_at_approximate": bool(
            v["liked_approx"] if "liked_approx" in v.keys() else 0),
        "source": (v["source"] if "source" in v.keys() else None) or "extension",
        "title": v["title"] or "",
        "channel": v["channel"] or "",
        "url": WATCH_URL.format(v["video_id"]),
        "duration_seconds": duration,
        "watch_seconds": round(total, 1),
        "window_watch_seconds": round(in_window, 1),
        "percent": pct_of(total),
        "window_percent": pct_of(in_window),
        "watched_days": len(days),
        "window_watched_days": len(window_days),
        "times_finished": v["watch_count"] or 0,
        "last_position_seconds": v["last_position"] or 0,
        "live": is_live,
        "orphan": False,
        "first_seen": v["first_seen"],
        "last_seen": v["last_seen"],
        "last_seen_perth": perth_day(v["last_seen"]).isoformat(),
        "sessions": [
            {
                "watched_at": s["watched_at"],
                "watched_at_perth": perth_day(s["watched_at"]).isoformat(),
                "seconds": s["seconds"],
                "stream_type": s["stream_type"],
            }
            for s in sessions
        ],
    }


def render_markdown(rows, since_text):
    if not rows:
        return f"# YouTube — last {since_text}\n\n_Nothing recorded in this window._\n"

    opened = len(rows)
    played = sum(1 for r in rows if r["window_watch_seconds"] > 0)
    total = sum(r["window_watch_seconds"] for r in rows)

    out = [f"# YouTube — last {since_text}", ""]
    summary = [f"{opened} tracked", f"{played} played", f"{fmt_duration(total)} active viewing"]
    liked_only = sum(1 for r in rows
                     if r["liked"] and r["window_watch_seconds"] <= 0)
    if liked_only:
        summary.insert(2, f"{liked_only} liked elsewhere")
    out.append("_" + " · ".join(summary) + "_")
    out.append("")

    current = None
    for r in rows:
        day = perth_day(r["last_seen"])
        key = day.date()
        if key != current:
            if current is not None:
                out.append("")
            current = key
            out.append(f"## {day.strftime('%a %d %b %Y')}")
            out.append("")

        title = r["title"] or f"(untitled — {r['video_id']})"
        marks = ("★" if r["liked"] else "") + ("*" if r["window_watched_days"] > 1 else "")
        out.append(f"- **[{title}]({r['url']})**" + (f" {marks}" if marks else ""))

        bits = []
        if r["channel"]:
            bits.append(r["channel"])
        watched = r["window_watch_seconds"]
        if r["live"]:
            bits.append(f"live · {fmt_duration(watched)} watched"
                        if watched else "live · not played")
        elif watched <= 0 and r["liked"]:
            # Known only because it was liked — most likely watched on the phone.
            # "not played" would be actively wrong here.
            bits.append("liked (date approximate) · watch time unknown"
                        if r["liked_at_approximate"] else "liked · watch time unknown")
            if r["duration_seconds"]:
                bits.append(f"{fmt_duration(r['duration_seconds'])} long")
        elif watched <= 0:
            bits.append("not played")
            if r["duration_seconds"]:
                bits.append(f"{fmt_duration(r['duration_seconds'])} long")
        else:
            piece = fmt_duration(watched)
            if r["duration_seconds"]:
                piece += f" of {fmt_duration(r['duration_seconds'])}"
            if r["window_percent"] is not None:
                piece += f" · {r['window_percent']}%"
            bits.append(piece)
        if r["orphan"]:
            bits.append("metadata missing")
        bits.append(day.strftime("%H:%M"))
        out.append(f"  {' · '.join(bits)}")

    legend = []
    if any(r["liked"] for r in rows):
        legend.append("★ liked")
    if any(r["window_watched_days"] > 1 for r in rows):
        legend.append("* watched on more than one day in this window")
    if legend:
        out += ["", "_" + " · ".join(legend) + "_"]
    return "\n".join(out) + "\n"



