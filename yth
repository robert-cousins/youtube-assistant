CONFIG_PATH = CONFIG_DIR / "config.json"
DEFAULT_CONFIG = {
    # Set this in ~/.config/yth/config.json before using the George button.
    # Deliberately empty: a hardcoded address would mail a stranger's summaries
    # to whoever happened to be baked into the source.
    "email_to": "",
    # Optional. Gmail fills From from the authorised account when this is blank;
    # set it (to that same address) only if you want a display name.
    "email_from_address": "",
    "email_from_name": "YouTube History",
    # Article fidelity is worth paying for: flash-lite is the cheapest tier and
    # the most prone to substituting familiar facts for transcript ones.
    "article_model": "google/gemini-2.5-flash-lite",
    "email_subject_prefix": "\U0001F4FA ",
}


def load_config():
    """Config file first, environment second, defaults last.

    Written out on first read so there is an obvious file to edit rather than a
    value buried in the source.
    """
    cfg = dict(DEFAULT_CONFIG)
    if CONFIG_PATH.exists():
        try:
            cfg.update(json.loads(CONFIG_PATH.read_text()))
        except ValueError:
            print(f"warning: {CONFIG_PATH} is not valid JSON; using defaults")
    else:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(json.dumps(cfg, indent=2) + "\n")
    # Environment wins, so a one-off run can override without editing the file.
    for key, env in (("email_to", "YTH_EMAIL_TO"),
                     ("email_from_name", "YTH_EMAIL_FROM_NAME")):
        if os.environ.get(env):
            cfg[key] = os.environ[env]
    return cfg



def markdown_to_html(text):
    """Small markdown renderer for the article email.

    Deliberately minimal and escape-first: headings, bold, italic, lists and
    paragraphs are all the article prompt asks for, and pulling in a dependency
    to render six constructs would not be a good trade.
    """
    blocks, buffer, out = [], [], []
    for line in (text or "").split("\n"):
        if line.strip():
            buffer.append(line)
        elif buffer:
            blocks.append(buffer); buffer = []
    if buffer:
        blocks.append(buffer)

    def inline(chunk):
        chunk = html_escape(chunk)
        chunk = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", chunk)
        chunk = re.sub(r"(?<!\*)\*(?!\s)(.+?)(?<!\s)\*(?!\*)", r"<em>\1</em>", chunk)
        return chunk

    for block in blocks:
        first = block[0].lstrip()
        if first.startswith("### "):
            out.append(f"<h3 style='margin:22px 0 8px;font-size:16px'>"
                       f"{inline(first[4:])}</h3>")
        elif first.startswith("## "):
            out.append(f"<h2 style='margin:26px 0 10px;font-size:19px;"
                       f"line-height:1.3'>{inline(first[3:])}</h2>")
        elif first.startswith("# "):
            out.append(f"<h1 style='margin:0 0 6px;font-size:25px;line-height:1.25'>"
                       f"{inline(first[2:])}</h1>")
        elif all(l.lstrip().startswith(("- ", "* ")) for l in block):
            items = "".join(f"<li style='margin:0 0 6px'>{inline(l.lstrip()[2:])}</li>"
                            for l in block)
            out.append(f"<ul style='margin:0 0 16px;padding-left:22px'>{items}</ul>")
        else:
            joined = " ".join(l.strip() for l in block)
            # An italic-only line straight after the headline is the byline.
            if len(out) == 1 and joined.startswith("*") and joined.endswith("*"):
                out.append(f"<p style='margin:0 0 20px;color:#666;font-size:14px'>"
                           f"{inline(joined.strip('*'))}</p>")
            else:
                out.append(f"<p style='margin:0 0 16px'>{inline(joined)}</p>")
    return "".join(out)


def article_headline(text, fallback):
    """Subject line: the model's headline if it produced one."""
    for line in (text or "").split("\n"):
        stripped = line.strip()
        # Models pick their own heading level for the headline -- this one
        # returns "## ...", so accept any level rather than only H1.
        heading = re.match(r"^#{1,3}\s+(.*)$", stripped)
        if heading:
            return heading.group(1).strip()[:160]
        if stripped and not stripped.startswith(("#", "*", "-", "_", ">")):
            return stripped[:160]
    return fallback


