def newest_export(quiet=False):
    files = [f for pattern in DEFAULT_EXPORT_GLOBS for f in glob(pattern)]
    if quiet and not files:
        raise SystemExit(1)
    if not files:
        searched = "\n  ".join(DEFAULT_EXPORT_GLOBS)
        sys.exit("No export found. Searched:\n  " + searched +
                 "\nExport from the extension's options page, or pass a path.")
    return max(files, key=os.path.getmtime)


def main():
    # --db is accepted both before and after the subcommand, since
    # `yth report --db X` is the form that comes naturally.
    # SUPPRESS on the subcommand copy is load-bearing: with a real default the
    # subparser would overwrite a --db given before the subcommand.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--db", default=argparse.SUPPRESS,
                        help="SQLite record (default: alongside yth)")

    ap = argparse.ArgumentParser(prog="yth", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--db", default=str(DEFAULT_DB),
                    help="SQLite record (default: alongside yth)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    imp = sub.add_parser("import", parents=[common], help="merge an export into the record")
    imp.add_argument("file", nargs="?", help="export JSON (default: newest in ~/Downloads)")

    au = sub.add_parser("auth", help="authorise against the YouTube Data API")
    src = au.add_mutually_exclusive_group(required=True)
    src.add_argument("--client-secret",
                     help="OAuth client JSON (Desktop app) from Google Cloud Console")
    src.add_argument("--from-env", action="store_true",
                     help="use GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET")
    au.add_argument("--gmail", action="store_true",
                    help="authorise sending mail (gmail.send) instead of YouTube "
                         "read access; stored separately so both can coexist")
    au.add_argument("--write", action="store_true",
                    help="authorise MODIFYING the YouTube account (unsubscribe). "
                         "This scope also permits playlist and video edits, so it "
                         "is stored separately and used only by the unsub worker")
    au.add_argument("--port", type=int, default=0,
                    help="fixed loopback port (needed for Web-application clients; "
                         "register http://127.0.0.1:<port> as an authorised redirect URI)")

    sl = sub.add_parser("sync-likes", parents=[common],
                        help="pull liked videos into the record")
    sl.add_argument("--verbose", action="store_true",
                    help="report the first page's date span")

    sv = sub.add_parser("serve", parents=[common],
                        help="run the local sync daemon the extension talks to")
    sv.add_argument("--port", type=int, default=DEFAULT_PORT)
    sv.add_argument("--sync-minutes", type=int, default=10,
                    help="how often to pull liked videos (default 10)")

    ex = sub.add_parser("export-extension", parents=[common],
                        help="write the record back out in the extension's import format")
    ex.add_argument("-o", "--out", default="yth-merged.json", help="output file")
    ex.add_argument("--force", action="store_true",
                    help="skip the superset safety check")

    bf = sub.add_parser("backfill", parents=[common],
                        help="fetch missing video descriptions from the API")
    bf.add_argument("--limit", type=int, default=1000,
                    help="maximum videos to fetch in this run")

    sm = sub.add_parser("summarise", parents=[common],
                        help="summarise one video's transcript")
    sm.add_argument("video_id")

    em = sub.add_parser("email", parents=[common],
                        help="summarise if needed, then email the summary")
    em.add_argument("video_id")
    em.add_argument("--to", help="override the configured recipient")
    em.add_argument("--force", action="store_true",
                    help="send again even if this video was already emailed")

    ar = sub.add_parser("article", parents=[common],
                        help="generate the long-form article for one video")
    ar.add_argument("video_id")

    vf = sub.add_parser("verify", parents=[common],
                        help="check an article's entities against the source")
    vf.add_argument("video_id")

    tm = sub.add_parser("terms", parents=[common],
                        help="manage per-channel caption repairs")
    tm.add_argument("--channel", help="channel these terms belong to")
    tm.add_argument("--add", action="append", metavar="WRONG=RIGHT",
                    help="add a repair, e.g. --add Besson=Bessent")
    tm.add_argument("--remove", metavar="WRONG", help="remove a repair")

    tk = sub.add_parser("track", parents=[common],
                        help="channels to watch for new uploads")
    tk.add_argument("action", nargs="?", default="list",
                    choices=["list", "add", "remove", "refresh", "subs"],
                    help="default: list")
    tk.add_argument("value", nargs="?",
                    help="channel URL, @handle or UC id (for add/remove)")

    sb = sub.add_parser("subs", parents=[common],
                        help="subscription manager: audit, queue unsubscribes")
    sb.add_argument("action", nargs="?", default="list",
                    choices=["list", "sync", "activity", "queue", "cancel",
                             "drain", "quota"],
                    help="default: list")
    sb.add_argument("value", nargs="?",
                    help="channel id (queue/cancel) or a count (activity/drain)")

    rs = sub.add_parser("resync", parents=[common],
                        help="force extensions to re-pull every row")

    hd = sub.add_parser("hidden", parents=[common],
                        help="list or restore videos removed from the History tab")
    hd.add_argument("--unhide", metavar="VIDEO_ID", help="restore one video")

    rep = sub.add_parser("report", parents=[common], help="render the record")
    rep.add_argument("--since", default="5d", type=parse_since, metavar="5d",
                     help="window: 5d, 2w, 36h (default: 5d)")
    rep.add_argument("--json", action="store_true", help="emit JSON instead of markdown")
    rep.add_argument("--unplayed-only", action="store_true", help="only videos with no watch time")
    rep.add_argument("--min-seconds", type=float, default=0.0,
                     help="hide videos with less watch time than this")

    args = ap.parse_args()

    if args.cmd == "auth":
        if args.gmail and args.write:
            sys.exit("--gmail and --write are different accounts and scopes; "
                     "authorise them one at a time.")
        if args.write:
            scope, creds = YOUTUBE_WRITE_SCOPE, WRITE_CREDS_PATH
        elif args.gmail:
            scope, creds = GMAIL_SEND_SCOPE, GMAIL_CREDS_PATH
        else:
            scope, creds = SCOPE, CREDS_PATH
        cmd_auth(args.client_secret, from_env=args.from_env, port=args.port,
                 scope=scope, creds_path=creds)
        return

    conn = connect(args.db)

    if args.cmd == "sync-likes":
        cmd_sync_likes(conn, verbose=args.verbose)
        return

    if args.cmd == "serve":
        conn.close()
        cmd_serve(args.db, args.port, args.sync_minutes)
        return

    if args.cmd == "backfill":
        total = 0
        while True:
            checked, _ = backfill_descriptions(conn, limit=min(200, args.limit - total))
            if not checked:
                break
            total += checked
            # Must match the pending criteria above, or the loop stops while
            # dates are still missing.
            remaining = conn.execute(
                "SELECT COUNT(*) FROM videos"
                " WHERE description IS NULL OR published_at IS NULL").fetchone()[0]
            print(f"  {remaining} still missing")
            if not remaining or total >= args.limit:
                break
        # Channel ids are what makes "when did I last watch this channel" exact
        # rather than a display-name guess, so the same command fills them.
        while True:
            found = backfill_channel_ids(conn, limit=200)
            left = conn.execute("SELECT COUNT(*) FROM videos"
                                " WHERE channel_id IS NULL").fetchone()[0]
            print(f"  {left} without a channel id")
            if not left:
                break
            if not found and left:
                # Everything remaining came back empty from the API; another
                # pass would ask the same questions and get the same nothing.
                break
        return

    if args.cmd == "summarise":
        cmd_summarise(conn, args.video_id)
        return

    if args.cmd == "email":
        cmd_email(conn, args.video_id, args.to, force=args.force)
        return

    if args.cmd == "article":
        cmd_article(conn, args.video_id)
        return

    if args.cmd == "verify":
        cmd_verify(conn, args.video_id)
        return

    if args.cmd == "terms":
        cmd_terms(conn, args.channel, args.add, args.remove)
        return

    if args.cmd == "track":
        if args.action in ("add", "remove") and not args.value:
            sys.exit(f"track {args.action} needs a channel URL, @handle or UC id")
        cmd_track(conn, args.action, args.value)
        return

    if args.cmd == "subs":
        if args.action == "queue" and not args.value:
            sys.exit("subs queue needs a channel id")
        cmd_subs(conn, args.action, args.value)
        return

    if args.cmd == "resync":
        cmd_resync(conn)
        return

    if args.cmd == "hidden":
        cmd_hidden(conn, args.unhide)
        return

    if args.cmd == "export-extension":
        cmd_export_extension(conn, args.out, force=args.force)
        return

    if args.cmd == "import":
        path = args.file or newest_export()
        try:
            new_v, new_s, new_e, tot_v, tot_s, tot_e = do_import(conn, path)
        except ExportFormatError as exc:
            sys.exit(f"Refusing to import {path}: {exc}")
        print(f"Imported {path}")
        print(f"  +{new_v} videos (of {tot_v} in export)")
        print(f"  +{new_s} sessions (of {tot_s} in export)")
        if tot_e:
            print(f"  +{new_e} watch events (of {tot_e} in export)")
        return

    since_counts, unit = args.since
    since_text = {"d": f"{since_counts['d']} days", "w": f"{since_counts['w'] // 7} weeks",
                  "h": f"{since_counts['h']} hours"}[unit]
    rows = gather(conn, window_start_ms(args.since))

    if args.unplayed_only:
        # "unplayed" means opened in the browser and never started. A video
        # known only from a like was probably watched on the phone, so it isn't
        # unplayed — it's unmeasured.
        rows = [r for r in rows
                if r["window_watch_seconds"] <= 0 and not r["liked"]]
    if args.min_seconds:
        rows = [r for r in rows if r["window_watch_seconds"] >= args.min_seconds]

    if args.json:
        print(json.dumps({"window": since_text, "timezone": "Australia/Perth (UTC+8)",
                          "generated_at": datetime.now(PERTH).isoformat(),
                          "count": len(rows), "videos": rows}, indent=2))
    else:
        print(render_markdown(rows, since_text), end="")


if __name__ == "__main__":
    main()
